{
  "$schema": "https://schemas.agentskills.io/skill/0.2.0/schema.json",
  "name": "claim-dossier-generate",
  "version": "1.0.0",
  "type": "skill-json",
  "description": "Draft a German goods-defect notice or an ordinary contract cancellation. The draft requires review before sending.",
  "invocation": {
    "type": "mcp",
    "endpoint": "https://rightsandrenewals.pages.dev/api/mcp",
    "tool": "claim_dossier_generate",
    "method": "POST"
  },
  "parameters": {
    "type": "object",
    "properties": {
      "brand_slug": {
        "type": "string",
        "minLength": 1,
        "description": "Brand or provider identifier"
      },
      "service_slug": {
        "type": "string",
        "minLength": 1,
        "description": "Alias for brand_slug"
      },
      "item_name": {
        "type": "string",
        "minLength": 1,
        "description": "Product name, or a legacy alias for contract_name"
      },
      "contract_name": {
        "type": "string",
        "minLength": 1,
        "description": "Name of the contract to cancel"
      },
      "contract_reference": {
        "type": "string",
        "description": "Optional contract reference"
      },
      "purchase_date": {
        "type": "string",
        "format": "date",
        "description": "Purchase date for a goods-defect notice"
      },
      "defect_description": {
        "type": "string",
        "minLength": 1,
        "description": "Factual defect description for a goods-defect notice"
      },
      "issue_type": {
        "type": "string",
        "enum": [
          "statutory_defect_claim",
          "contract_cancellation"
        ],
        "default": "statutory_defect_claim"
      }
    },
    "allOf": [
      {
        "anyOf": [
          {
            "required": [
              "brand_slug"
            ]
          },
          {
            "required": [
              "service_slug"
            ]
          }
        ]
      },
      {
        "if": {
          "required": [
            "issue_type"
          ],
          "properties": {
            "issue_type": {
              "const": "contract_cancellation"
            }
          }
        },
        "then": {
          "anyOf": [
            {
              "required": [
                "contract_name"
              ]
            },
            {
              "required": [
                "item_name"
              ]
            }
          ]
        },
        "else": {
          "required": [
            "item_name",
            "purchase_date",
            "defect_description"
          ]
        }
      }
    ]
  },
  "examples": [
    {
      "intent": "Generate defect claim letter for a flickering monitor",
      "arguments": {
        "brand_slug": "apple",
        "item_name": "Studio Display",
        "purchase_date": "2024-05-10",
        "defect_description": "Display backlight flickering intermittently after 6 months of use",
        "issue_type": "statutory_defect_claim"
      }
    },
    {
      "intent": "Draft ordinary cancellation of a synthetic streaming subscription",
      "arguments": {
        "service_slug": "netflix",
        "contract_name": "Synthetic Netflix subscription",
        "issue_type": "contract_cancellation"
      }
    }
  ]
}
