{
  "$schema": "https://schemas.agentskills.io/skill/0.2.0/schema.json",
  "name": "policy-lookup",
  "version": "1.0.0",
  "type": "skill-json",
  "description": "Look up cataloged German goods or subscription policies with statutory and available provider sources.",
  "invocation": {
    "type": "mcp",
    "endpoint": "https://rightsandrenewals.pages.dev/api/mcp",
    "tool": "policy_lookup",
    "method": "POST"
  },
  "parameters": {
    "type": "object",
    "properties": {
      "service_slug": {
        "type": "string",
        "minLength": 1
      },
      "brand_slug": {
        "type": "string",
        "minLength": 1,
        "description": "Alias for service_slug"
      },
      "category": {
        "type": "string",
        "enum": [
          "hardware",
          "subscription"
        ],
        "description": "Optional assertion of the catalog category"
      }
    },
    "anyOf": [
      {
        "required": [
          "service_slug"
        ]
      },
      {
        "required": [
          "brand_slug"
        ]
      }
    ],
    "additionalProperties": false
  },
  "examples": [
    {
      "intent": "Check warranty terms for MediaMarkt purchase",
      "arguments": {
        "service_slug": "mediamarkt",
        "category": "hardware"
      }
    },
    {
      "intent": "Look up Spotify cancellation policy in Germany",
      "arguments": {
        "service_slug": "spotify",
        "category": "subscription"
      }
    }
  ]
}
