{
  "$schema": "https://schemas.agentskills.io/skill/0.2.0/schema.json",
  "name": "bgb-statutory-calculator",
  "version": "1.0.0",
  "type": "skill-json",
  "description": "Read a dated German Civil Code reference with an official source and scope notes.",
  "invocation": {
    "type": "mcp",
    "endpoint": "https://rightsandrenewals.pages.dev/api/mcp",
    "tool": "statutory_law_lookup",
    "method": "POST"
  },
  "parameters": {
    "type": "object",
    "properties": {
      "statute_section": {
        "type": "string",
        "enum": [
          "434",
          "437",
          "438",
          "439",
          "475e",
          "477",
          "309_nr_9",
          "312g",
          "312k",
          "355"
        ]
      },
      "language": {
        "type": "string",
        "enum": [
          "de",
          "en"
        ],
        "default": "de"
      }
    },
    "required": [
      "statute_section"
    ],
    "additionalProperties": false
  },
  "examples": [
    {
      "intent": "Check 12-month burden of proof reversal rules under BGB § 477",
      "arguments": {
        "statute_section": "477"
      }
    },
    {
      "intent": "Lookup maximum tacit renewal periods under BGB § 309 Nr. 9",
      "arguments": {
        "statute_section": "309_nr_9"
      }
    }
  ]
}
