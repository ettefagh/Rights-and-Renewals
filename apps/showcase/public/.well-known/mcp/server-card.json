{
  "$schema": "https://static.modelcontextprotocol.io/schemas/v1/server-card.schema.json",
  "version": "1.0",
  "serverInfo": {
    "name": "rights-and-renewals",
    "version": "2.0.0",
    "title": "Rights & Renewals MCP Server",
    "description": "Public read-only German consumer policy and law lookups."
  },
  "title": "Rights & Renewals MCP Server",
  "description": "Public MCP for German brand policy, statutory sources, and scoped subscription rules.",
  "url": "https://rightsandrenewals.pages.dev/api/mcp",
  "websiteUrl": "https://rightsandrenewals.pages.dev/agent-setup",
  "transport": {
    "type": "streamable-http",
    "endpoint": "https://rightsandrenewals.pages.dev/api/mcp"
  },
  "transports": [
    {
      "type": "streamable-http",
      "url": "https://rightsandrenewals.pages.dev/api/mcp",
      "formats": [
        "application/json"
      ]
    }
  ],
  "remotes": [
    {
      "type": "streamable-http",
      "url": "https://rightsandrenewals.pages.dev/api/mcp",
      "protocolVersions": [
        "2025-11-25",
        "2025-06-18",
        "2025-03-26"
      ]
    }
  ],
  "capabilities": {
    "tools": {
      "listChanged": false
    }
  },
  "tools": [
    {
      "name": "policy_lookup",
      "description": "Look up cataloged German goods or subscription policies with statutory and available provider sources.",
      "annotations": {
        "readOnlyHint": true,
        "openWorldHint": false
      },
      "inputSchema": {
        "type": "object",
        "properties": {
          "service_slug": {
            "type": "string",
            "minLength": 1
          },
          "brand_slug": {
            "type": "string",
            "minLength": 1,
            "description": "Alias for service_slug"
          },
          "category": {
            "type": "string",
            "enum": [
              "hardware",
              "subscription"
            ],
            "description": "Optional assertion of the catalog category"
          }
        },
        "anyOf": [
          {
            "required": [
              "service_slug"
            ]
          },
          {
            "required": [
              "brand_slug"
            ]
          }
        ],
        "additionalProperties": false
      },
      "outputSchema": {
        "type": "object",
        "properties": {
          "brand_slug": {
            "type": "string"
          },
          "brand_name": {
            "type": "string"
          },
          "category": {
            "type": "string",
            "enum": [
              "hardware",
              "subscription"
            ]
          },
          "jurisdiction": {
            "type": "string",
            "const": "DE"
          },
          "statutory_warranty_months": {
            "type": [
              "integer",
              "null"
            ]
          },
          "commercial_guarantee_months": {
            "type": [
              "integer",
              "null"
            ]
          },
          "reversed_burden_months": {
            "type": [
              "integer",
              "null"
            ]
          },
          "cancellation_notice_months": {
            "type": [
              "integer",
              "null"
            ]
          },
          "cancellation_button_compliant": {
            "type": [
              "boolean",
              "null"
            ]
          },
          "legal_scope": {
            "type": "string"
          },
          "legal_notes": {
            "type": "string"
          },
          "catalog_record_date": {
            "type": "string"
          },
          "sources": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "properties": {
                "title": {
                  "type": "string"
                },
                "url": {
                  "type": "string",
                  "format": "uri"
                }
              },
              "required": [
                "title",
                "url"
              ]
            }
          },
          "cancellation_url": {
            "type": "string"
          },
          "support_email": {
            "type": "string"
          }
        },
        "required": [
          "brand_slug",
          "brand_name",
          "category",
          "jurisdiction",
          "statutory_warranty_months",
          "commercial_guarantee_months",
          "reversed_burden_months",
          "cancellation_notice_months",
          "cancellation_button_compliant",
          "legal_scope",
          "legal_notes",
          "catalog_record_date",
          "sources"
        ]
      }
    },
    {
      "name": "statutory_law_lookup",
      "description": "Read a dated German Civil Code reference with an official source and scope notes.",
      "annotations": {
        "readOnlyHint": true,
        "openWorldHint": false
      },
      "inputSchema": {
        "type": "object",
        "properties": {
          "statute_section": {
            "type": "string",
            "enum": [
              "434",
              "437",
              "438",
              "439",
              "475e",
              "477",
              "309_nr_9",
              "312g",
              "312k",
              "355"
            ]
          },
          "language": {
            "type": "string",
            "enum": [
              "de",
              "en"
            ],
            "default": "de"
          }
        },
        "required": [
          "statute_section"
        ],
        "additionalProperties": false
      },
      "outputSchema": {
        "type": "object",
        "properties": {
          "section": {
            "type": "string"
          },
          "title": {
            "type": "string"
          },
          "language": {
            "type": "string"
          },
          "statutory_text": {
            "type": "string"
          },
          "legal_summary": {
            "type": "string"
          },
          "source": {
            "type": "string",
            "format": "uri"
          },
          "scope_note": {
            "type": "string"
          },
          "text_status": {
            "type": "string"
          },
          "statute_section": {
            "type": "string"
          },
          "effective_date": {
            "type": [
              "string",
              "null"
            ]
          },
          "source_checked_on": {
            "type": "string",
            "format": "date"
          },
          "duration_months": {
            "type": [
              "integer",
              "null"
            ]
          },
          "statutory_basis": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "required": [
          "section",
          "title",
          "language",
          "statutory_text",
          "legal_summary",
          "source",
          "scope_note",
          "text_status"
        ]
      }
    },
    {
      "name": "subscription_category_rules",
      "description": "Explain when German standard-term and online cancellation rules may apply to consumer subscriptions.",
      "annotations": {
        "readOnlyHint": true,
        "openWorldHint": false
      },
      "inputSchema": {
        "type": "object",
        "properties": {
          "subscription_type": {
            "type": "string",
            "enum": [
              "streaming",
              "gym",
              "telecom",
              "software",
              "cloud",
              "press",
              "energy",
              "generic",
              "gym_fitness",
              "streaming_media",
              "saas_software",
              "telecom_mobile_internet",
              "press_news_subscription",
              "energy_utility"
            ]
          },
          "contract_category": {
            "type": "string",
            "enum": [
              "generic",
              "gym_fitness",
              "streaming_media",
              "saas_software",
              "telecom_mobile_internet",
              "press_news_subscription",
              "energy_utility"
            ]
          },
          "contract_start_date": {
            "type": "string",
            "format": "date",
            "description": "Date the contract was concluded, if known"
          }
        },
        "anyOf": [
          {
            "required": [
              "subscription_type"
            ]
          },
          {
            "required": [
              "contract_category"
            ]
          }
        ],
        "additionalProperties": false
      },
      "outputSchema": {
        "type": "object",
        "properties": {
          "category": {
            "type": "string"
          },
          "max_initial_term_months": {
            "type": [
              "integer",
              "null"
            ]
          },
          "automatic_renewal_rule": {
            "type": "string"
          },
          "max_cancellation_notice_period_days": {
            "type": [
              "integer",
              "null"
            ]
          },
          "cancellation_button_mandatory": {
            "type": [
              "boolean",
              "null"
            ]
          },
          "governing_statutes": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "rule_scope": {
            "type": "string"
          },
          "scope_note": {
            "type": "string"
          },
          "ordinary_termination": {
            "type": "string"
          },
          "extraordinary_termination": {
            "type": "string"
          },
          "sources": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "properties": {
                "title": {
                  "type": "string"
                },
                "url": {
                  "type": "string",
                  "format": "uri"
                }
              },
              "required": [
                "title",
                "url"
              ]
            }
          },
          "contract_start_date": {
            "type": [
              "string",
              "null"
            ]
          },
          "dark_pattern_alert": {
            "type": "string"
          }
        },
        "required": [
          "category",
          "max_initial_term_months",
          "automatic_renewal_rule",
          "max_cancellation_notice_period_days",
          "cancellation_button_mandatory",
          "governing_statutes",
          "rule_scope",
          "scope_note",
          "ordinary_termination",
          "extraordinary_termination",
          "sources"
        ]
      }
    }
  ]
}
