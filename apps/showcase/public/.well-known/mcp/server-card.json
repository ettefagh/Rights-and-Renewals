{
  "$schema": "https://static.modelcontextprotocol.io/schemas/v1/server-card.schema.json",
  "version": "1.0",
  "serverInfo": {
    "name": "rights-and-renewals",
    "version": "1.0.0",
    "title": "Rights & Renewals MCP Server",
    "description": "Sovereign consumer rights lookup, statutory warranty defense, contract renewal tracking, and automated cancellation letter generation."
  },
  "title": "Rights & Renewals MCP Server",
  "description": "Authoritative Model Context Protocol server for German statutory consumer warranty rights (BGB §§ 434, 437, 438, 477), subscription cancellation laws (BGB § 309 Nr. 9, § 312k), and tax deductibility evaluation (BMF 2022).",
  "url": "https://rightsandrenewals.pages.dev/api/mcp",
  "websiteUrl": "https://rightsandrenewals.pages.dev/agent-setup",
  "transport": {
    "type": "streamable-http",
    "endpoint": "https://rightsandrenewals.pages.dev/api/mcp"
  },
  "transports": [
    {
      "type": "streamable-http",
      "url": "https://rightsandrenewals.pages.dev/api/mcp",
      "formats": [
        "application/json"
      ]
    }
  ],
  "remotes": [
    {
      "type": "streamable-http",
      "url": "https://rightsandrenewals.pages.dev/api/mcp",
      "protocolVersions": [
        "2024-11-05",
        "2025-11-25"
      ]
    }
  ],
  "capabilities": {
    "tools": {
      "listChanged": false
    },
    "resources": {
      "subscribe": false,
      "listChanged": false
    },
    "prompts": {
      "listChanged": false
    }
  },
  "tools": [
    {
      "name": "policy_lookup",
      "description": "Look up scoped German goods or subscription policies, with statutory and available provider sources.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "service_slug": {
            "type": "string",
            "description": "Brand or service slug (e.g. 'spotify', 'apple', 'mediamarkt')"
          },
          "brand_slug": {
            "type": "string",
            "description": "Alias for service_slug for dual-slug compatibility"
          },
          "category": {
            "type": "string",
            "enum": [
              "hardware",
              "subscription"
            ]
          }
        },
        "anyOf": [
          {
            "required": [
              "service_slug"
            ]
          },
          {
            "required": [
              "brand_slug"
            ]
          }
        ]
      }
    },
    {
      "name": "claim_dossier_generate",
      "description": "Draft a German goods-defect notice or an ordinary contract cancellation. The draft requires review before sending.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "brand_slug": {
            "type": "string",
            "minLength": 1,
            "description": "Brand or provider identifier"
          },
          "service_slug": {
            "type": "string",
            "minLength": 1,
            "description": "Alias for brand_slug"
          },
          "item_name": {
            "type": "string",
            "minLength": 1,
            "description": "Product name, or a legacy alias for contract_name"
          },
          "contract_name": {
            "type": "string",
            "minLength": 1,
            "description": "Name of the contract to cancel"
          },
          "contract_reference": {
            "type": "string",
            "description": "Optional contract reference"
          },
          "purchase_date": {
            "type": "string",
            "format": "date",
            "description": "Purchase date for a goods-defect notice"
          },
          "defect_description": {
            "type": "string",
            "minLength": 1,
            "description": "Factual defect description for a goods-defect notice"
          },
          "issue_type": {
            "type": "string",
            "enum": [
              "statutory_defect_claim",
              "contract_cancellation"
            ],
            "default": "statutory_defect_claim"
          }
        },
        "allOf": [
          {
            "anyOf": [
              {
                "required": [
                  "brand_slug"
                ]
              },
              {
                "required": [
                  "service_slug"
                ]
              }
            ]
          },
          {
            "if": {
              "required": [
                "issue_type"
              ],
              "properties": {
                "issue_type": {
                  "const": "contract_cancellation"
                }
              }
            },
            "then": {
              "anyOf": [
                {
                  "required": [
                    "contract_name"
                  ]
                },
                {
                  "required": [
                    "item_name"
                  ]
                }
              ]
            },
            "else": {
              "required": [
                "item_name",
                "purchase_date",
                "defect_description"
              ]
            }
          }
        ]
      }
    },
    {
      "name": "statutory_law_lookup",
      "description": "Look up verbatim German statutory consumer law clauses (BGB §§ 437, 438, 477, 309 Nr. 9, 312k) and legal guidance.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "section": {
            "type": "string",
            "description": "Statutory section code, e.g. '477', '312k', '309', '437', '438'"
          }
        },
        "required": [
          "section"
        ]
      }
    },
    {
      "name": "subscription_category_rules",
      "description": "Retrieve legal renewal rules, maximum statutory notice periods, and mandatory cancellation button requirements for a subscription category.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "category": {
            "type": "string",
            "description": "Category name, e.g. 'streaming', 'telecom', 'software', 'fitness'"
          }
        },
        "required": [
          "category"
        ]
      }
    },
    {
      "name": "tax_deductibility_check",
      "description": "Screen German work or study expenses. Generic categories require manual review. BMF one-year useful life is limited to specified hardware and acquired software.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "item_name": {
            "type": "string",
            "description": "Name of the item or asset"
          },
          "asset_name": {
            "type": "string",
            "description": "Canonical asset name"
          },
          "item_category": {
            "type": "string",
            "enum": [
              "hardware",
              "subscription"
            ]
          },
          "asset_category": {
            "type": "string",
            "enum": [
              "computer_hardware",
              "peripherals",
              "software_saas",
              "subscription",
              "hardware",
              "acquired_business_software",
              "academic_literature",
              "smartphone",
              "office_furniture"
            ]
          },
          "gross_price_eur": {
            "type": "number",
            "exclusiveMinimum": 0
          },
          "professional_use_percent": {
            "type": "number",
            "minimum": 0,
            "maximum": 100
          },
          "academic_usage_percent": {
            "type": "number",
            "minimum": 0,
            "maximum": 100
          },
          "taxpayer_status": {
            "type": "string",
            "enum": [
              "master_zweitstudium",
              "werkstudent_employee",
              "bachelor_erststudium"
            ]
          },
          "purchase_date": {
            "type": "string",
            "format": "date"
          }
        },
        "required": [
          "gross_price_eur"
        ],
        "allOf": [
          {
            "anyOf": [
              {
                "required": [
                  "asset_name"
                ]
              },
              {
                "required": [
                  "item_name"
                ]
              }
            ]
          },
          {
            "anyOf": [
              {
                "required": [
                  "asset_category"
                ]
              },
              {
                "required": [
                  "item_category"
                ]
              }
            ]
          }
        ]
      }
    }
  ]
}
