{
  "name": "@cmlab/showcase",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "CM-LAB Public Showcase, EmDash-backed Brand Policy Wiki & Open MCP Server",
  "emdash": {
    "label": "Rights & Renewals",
    "seed": "seed/seed.json"
  },
  "scripts": {
    "dev": "astro dev --port 3000 --host",
    "build": "astro build",
    "test": "vitest run",
    "preview": "astro preview --port 3000",
    "check": "svelte-check --tsconfig ./tsconfig.json",
    "emdash:sync-policy-seed": "node scripts/sync-policy-seed.mjs",
    "emdash:import-policies": "node scripts/import-policy-content.mjs",
    "emdash:sync-editorial-seed": "node scripts/sync-editorial-seed.mjs",
    "emdash:import-editorial": "node scripts/import-editorial-content.mjs",
    "emdash:types": "node scripts/generate-emdash-types.mjs",
    "serve": "python -m http.server 3000 --directory dist",
    "test:e2e": "python ../../tests/e2e/runner.py"
  },
  "dependencies": {
    "@astrojs/cloudflare": "13.7.0",
    "@astrojs/react": "7.1.5",
    "@astrojs/svelte": "8.1.2",
    "@cmlab/core": "workspace:*",
    "@cmlab/design-tokens": "workspace:*",
    "@emdash-cms/cloudflare": "^1.4.0",
    "@iconify-json/simple-icons": "^1.2.101",
    "@threlte/core": "^8.0.0",
    "@threlte/extras": "^9.0.0",
    "astro": "6.4.8",
    "emdash": "^1.4.0",
    "lucide-svelte": "^1.0.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "svelte": "^5.0.0",
    "three": "^0.170.0",
    "unplugin-icons": "^24.0.0",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "5.20261109.1",
    "@types/node": "^22.0.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/three": "^0.170.0",
    "svelte-check": "^4.0.0",
    "typescript": "^5.8.2",
    "vitest": "^3.0.7",
    "wrangler": "4.159.0"
  }
}
