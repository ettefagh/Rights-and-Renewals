{
	"$schema": "https://emdashcms.com/seed.schema.json",
	"version": "1",
	"meta": {
		"name": "Rights & Renewals",
		"description": "EmDash CMS schema and starter content for Rights & Renewals",
		"author": "Rights & Renewals"
	},
	"settings": {
		"title": "Rights & Renewals",
		"tagline": "Sovereign Consumer Warranty & Subscription Rights"
	},
	"collections": [
		{
			"slug": "posts",
			"label": "Posts",
			"labelSingular": "Post",
			"urlPattern": "/posts/{slug}",
			"supports": [
				"drafts",
				"revisions",
				"preview",
				"scheduling",
				"search",
				"seo"
			],
			"fields": [
				{
					"slug": "title",
					"label": "Title",
					"type": "string",
					"required": true,
					"searchable": true
				},
				{
					"slug": "featured_image",
					"label": "Featured Image",
					"type": "image"
				},
				{
					"slug": "content",
					"label": "Content",
					"type": "portableText",
					"searchable": true
				},
				{
					"slug": "excerpt",
					"label": "Excerpt",
					"type": "text"
				}
			]
		},
		{
			"slug": "pages",
			"label": "Pages",
			"labelSingular": "Page",
			"urlPattern": "/{slug}",
			"supports": [
				"drafts",
				"revisions",
				"preview",
				"search",
				"seo"
			],
			"fields": [
				{
					"slug": "title",
					"label": "Title",
					"type": "string",
					"required": true,
					"searchable": true
				},
				{
					"slug": "content",
					"label": "Content",
					"type": "portableText",
					"searchable": true
				}
			]
		},
		{
			"slug": "brand_policies",
			"label": "Brand Policies",
			"labelSingular": "Brand Policy",
			"description": "Published German consumer warranty and subscription policy records.",
			"urlPattern": "/wiki/{slug}",
			"titleField": "title",
			"supports": [
				"drafts",
				"revisions",
				"preview",
				"search",
				"seo"
			],
			"fields": [
				{
					"slug": "title",
					"label": "Brand name",
					"type": "string",
					"required": true,
					"searchable": true,
					"validation": {
						"minLength": 1,
						"maxLength": 160
					}
				},
				{
					"slug": "category",
					"label": "Category",
					"type": "select",
					"required": true,
					"validation": {
						"options": [
							"subscription",
							"hardware"
						]
					}
				},
				{
					"slug": "statutory_warranty_months",
					"label": "Statutory warranty (months)",
					"type": "integer",
					"required": true,
					"validation": {
						"min": 0,
						"max": 120
					}
				},
				{
					"slug": "commercial_guarantee_months",
					"label": "Commercial guarantee (months)",
					"type": "integer",
					"required": true,
					"validation": {
						"min": 0,
						"max": 120
					}
				},
				{
					"slug": "cancellation_notice_months",
					"label": "Cancellation notice (months)",
					"type": "integer",
					"required": true,
					"validation": {
						"min": 0,
						"max": 120
					}
				},
				{
					"slug": "cancellation_button_compliant",
					"label": "Cancellation button reviewed as compliant",
					"type": "boolean",
					"required": true,
					"defaultValue": false
				},
				{
					"slug": "cancellation_url",
					"label": "Cancellation link",
					"type": "url"
				},
				{
					"slug": "support_email",
					"label": "Support email",
					"type": "string",
					"validation": {
						"pattern": "^[^\\s@]+@[^\\s@]+\\.[^\\s@]+$"
					}
				},
				{
					"slug": "legal_notes",
					"label": "Policy notes",
					"type": "text",
					"required": true,
					"searchable": true
				},
				{
					"slug": "verified_date",
					"label": "Last verified (date)",
					"type": "string",
					"required": true,
					"validation": {
						"pattern": "^\\d{4}-\\d{2}-\\d{2}$"
					}
				},
				{
					"slug": "search_aliases",
					"label": "Search aliases (JSON array of strings)",
					"type": "json",
					"required": true,
					"defaultValue": []
				}
			]
		}
	],
	"taxonomies": [
		{
			"name": "category",
			"label": "Categories",
			"labelSingular": "Category",
			"hierarchical": true,
			"collections": [
				"posts"
			],
			"terms": [
				{
					"slug": "general",
					"label": "General"
				},
				{
					"slug": "updates",
					"label": "Updates"
				}
			]
		},
		{
			"name": "tag",
			"label": "Tags",
			"labelSingular": "Tag",
			"hierarchical": false,
			"collections": [
				"posts"
			],
			"terms": [
				{
					"slug": "starter",
					"label": "Starter"
				},
				{
					"slug": "example",
					"label": "Example"
				}
			]
		}
	],
	"menus": [
		{
			"name": "primary",
			"label": "Primary Navigation",
			"items": [
				{
					"type": "custom",
					"label": "Home",
					"url": "/"
				},
				{
					"type": "custom",
					"label": "Posts",
					"url": "/posts"
				},
				{
					"type": "custom",
					"label": "About",
					"url": "/about"
				}
			]
		}
	],
	"widgetAreas": [
		{
			"name": "sidebar",
			"label": "Sidebar",
			"description": "Sidebar widget area",
			"widgets": [
				{
					"type": "component",
					"componentId": "core:search",
					"title": "Search"
				},
				{
					"type": "component",
					"componentId": "core:categories",
					"title": "Categories"
				},
				{
					"type": "component",
					"componentId": "core:recent-posts",
					"title": "Recent Posts",
					"props": {
						"count": 5
					}
				}
			]
		}
	],
