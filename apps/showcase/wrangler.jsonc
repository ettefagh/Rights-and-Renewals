{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "rightsandrenewals-showcase",
  "main": "./src/worker.ts",
  "compatibility_date": "2026-11-10",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "workers_dev": false,
  "preview_urls": false,
  "assets": {
    "run_worker_first": [
      "/auth.md",
      "/robots.txt",
      "/sitemap.xml",
      "/agent-setup/prompt.md",
      "/.well-known/*"
    ]
  },
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1
    },
    "traces": {
      "enabled": true,
      "head_sampling_rate": 0.01
    }
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "rightsandrenewals-db",
      "database_id": "b8bbd6ff-9dd1-4fef-b17a-3c370859ff7b"
    }
  ],
  "r2_buckets": [
    {
      "binding": "MEDIA",
      "bucket_name": "rightsandrenewals-media"
    }
  ],
  "kv_namespaces": [
    {
      "binding": "SESSION",
      "id": "42693ee204b84807862e170724721f57"
    }
  ]
}
