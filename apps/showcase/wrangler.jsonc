{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "rightsandrenewals-showcase",
  "main": "./src/worker.ts",
  "compatibility_date": "2026-11-10",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "workers_dev": false,
  "preview_urls": false,
  "assets": {
    "run_worker_first": [
      "/auth.md",
      "/robots.txt",
      "/sitemap.xml",
      "/agent-setup/prompt.md",
      "/.well-known/*"
    ]
  },
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1
    },
    "traces": {
      "enabled": true,
      "head_sampling_rate": 0.01
    }
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "rightsandrenewals-db",
      "database_id": "b8bbd6ff-9dd1-4fef-b17a-3c370859ff7b"
    }
  ],
  "r2_buckets": [
    {
      "binding": "MEDIA",
      "bucket_name": "rightsandrenewals-media"
    }
  ],
  "kv_namespaces": [
    {
      "binding": "SESSION",
      "id": "42693ee204b84807862e170724721f57"
    }
  ],
  "previews": {
    "d1_databases": [
      {
        "binding": "DB",
        "database_name": "rightsandrenewals-issue35-preview",
        "database_id": "5cd616d4-a667-491d-99bb-64f98d797334"
      }
    ],
    "r2_buckets": [
      {
        "binding": "MEDIA",
        "bucket_name": "rightsandrenewals-issue35-preview-media"
      }
    ],
    "kv_namespaces": [
      {
        "binding": "SESSION",
        "id": "9b41215bc3864481b5e52bfa802a3af8"
      }
    ]
  }
}
