{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "rightsandrenewals",
  "compatibility_date": "2025-01-01",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "pages_build_output_dir": "./dist",
  "observability": {
    "enabled": true
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "rightsandrenewals-db",
      "database_id": "b8bbd6ff-9dd1-4fef-b17a-3c370859ff7b"
    }
  ],
  "r2_buckets": [
    {
      "binding": "MEDIA",
      "bucket_name": "rightsandrenewals-media"
    }
  ],
  "kv_namespaces": [
    {
      "binding": "SESSION",
      "id": "42693ee204b84807862e170724721f57"
    }
  ]
}
