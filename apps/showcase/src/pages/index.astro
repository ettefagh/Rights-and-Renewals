---
import '../../styles/tokens.css';
import '../../styles/main.css';
import { CalendarDays, ChevronRight, Menu, RefreshCw } from 'lucide-svelte';

export const prerender = true;
---

<!DOCTYPE html>
<html lang="en" data-theme="light">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
  <title>Rights &amp; Renewals · CM-LAB · MCP Server &amp; Consumer Wallet Showcase</title>
  <meta name="description" content="Track purchases and subscriptions in an offline-first wallet. Explore practical consumer policy information and a public MCP playground." />
  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  <link rel="icon" type="image/png" sizes="64x64" href="/favicon.png" />
  <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />

  <!-- AI-Agent Discovery Standards Links (RFC 8288 / ARD / SEP-2127 / AgentSkills) -->
  <link rel="ai-catalog" href="/.well-known/ai-catalog.json" />
  <link rel="mcp-server-card" href="/.well-known/mcp/server-card.json" />
  <link rel="agent-skills" href="/.well-known/agent-skills/index.json" />
  <link rel="service-desc" href="/api/mcp" />

  <!-- Zero-FOUC Theme Initialization -->
  <script is:inline>
    (function() {
      try {
        const saved = localStorage.getItem('cmlab-theme');
        const systemDark = window.matchMedia && window.matchMedia('(prefers-color-scheme: dark)').matches;
        document.documentElement.setAttribute('data-theme', saved || (systemDark ? 'dark' : 'light'));
      } catch (e) {}
    })();

    window.toggleTheme = function() {
      const current = document.documentElement.getAttribute('data-theme');
      const next = current === 'dark' ? 'light' : 'dark';
      document.documentElement.setAttribute('data-theme', next);
      try { localStorage.setItem('cmlab-theme', next); } catch (e) {}
    };
  </script>

  <!-- W3C DTCG 3-Tier Design System Stylesheets -->
  <link rel="stylesheet" href="/styles/tokens.css" />
  <link rel="stylesheet" href="/styles/main.css" />
</head>
<body class="showcase-shell">

  <!-- ========================================================================
       STICKY UTILITY HEADER
       ======================================================================== -->
  <header role="banner" id="app-header" class="showcase-header">
    <div class="layout-container header-inner">
      <a href="/" class="brand-link" aria-label="Rights & Renewals Home" style="display: inline-flex; align-items: center; gap: 10px;">
        <img src="/favicon.svg" alt="Rights & Renewals Icon" width="32" height="32" style="border-radius: 8px; display: block;" />
        <span class="brand-name">Rights &amp; Renewals</span>
      </a>

      <nav class="nav-links" aria-label="Main Navigation">
        <a href="#wallet-demo" class="nav-item">Wallet demo</a>
        <a href="/wiki" class="nav-item">Policy Wiki</a>
        <a href="#mcp-playground" class="nav-item">MCP Playground</a>
        <a href="/emdash" class="nav-item">EmDash CMS</a>
        <a href="/agent-setup" class="nav-item" data-action="open-quick-connect" id="header-connect-btn">Agent setup</a>
      </nav>

      <div class="nav-actions">
        <button class="theme-toggle-btn" id="theme-toggle-btn" onclick="window.toggleTheme()" aria-label="Toggle theme" title="Toggle theme">
          <span class="theme-icon" aria-hidden="true">🌙</span>
        </button>
        <a href="https://rightsandrenewals-app.pages.dev/" data-legacy-url="https://app.cm-lab.pages.dev/" class="btn-compact btn-primary" target="_blank" rel="noopener noreferrer">
          Open wallet ↗
        </a>
      </div>
      <details class="mobile-nav">
        <summary aria-label="Menu"><Menu size={24} aria-hidden="true" /><span class="sr-only">Menu</span></summary>
        <nav class="mobile-nav-panel" aria-label="Mobile navigation">
          <a href="#wallet-demo">Wallet demo</a>
          <a href="/wiki">Policy Wiki</a>
          <a href="#mcp-playground">MCP Playground</a>
          <a href="/emdash">EmDash CMS</a>
          <a href="/agent-setup">Agent setup</a>
        </nav>
      </details>
    </div>
  </header>

  <!-- ========================================================================
       MAIN SHOWCASE CONTENT
       ======================================================================== -->
  <main id="showcase-main">

    <!-- PUBLIC INTRO AND FICTIONAL SAMPLE PREVIEW -->
    <section id="hero" class="hero-section">
      <div class="layout-container showcase-landing">
        <div class="showcase-lead">
          <h1 class="hero-title">Keep the receipt.<br />Know the deadline.</h1>
          <p class="hero-subtitle">Track purchases and subscriptions in a wallet that keeps your receipts on your device.</p>
          <div class="hero-ctas">
            <a href="https://rightsandrenewals-app.pages.dev/" data-legacy-url="https://app.cm-lab.pages.dev/" class="btn btn-primary" target="_blank" rel="noopener noreferrer">Open wallet ↗</a>
            <a href="#wallet-demo" class="btn btn-outline">Try the demo</a>
          </div>
        </div>

        <section id="wallet-demo" class="sample-preview" aria-labelledby="sample-preview-title">
          <div class="sample-preview-heading">
            <h2 id="sample-preview-title">Interactive demo</h2>
            <span class="sample-data-label">Fictional sample data</span>
          </div>
          <p class="sample-preview-date">Upcoming dates · 10 Nov 2026</p>
          <details class="sample-item">
            <summary><span class="sample-icon sample-icon-deadline"><CalendarDays size={30} aria-hidden="true" /></span><span><strong>FitX</strong><small>Cancel by 12 Nov</small></span><ChevronRight class="sample-chevron" size={22} aria-hidden="true" /></summary>
            <p>This example is fictional and for demonstration only. Open the wallet to track your own subscriptions.</p>
          </details>
          <details class="sample-item">
            <summary><span class="sample-icon sample-icon-renewal"><RefreshCw size={30} aria-hidden="true" /></span><span><strong>Spotify Premium</strong><small>Renews 1 Dec</small></span><ChevronRight class="sample-chevron" size={22} aria-hidden="true" /></summary>
            <p>This example is fictional and for demonstration only. Your wallet data stays on your device.</p>
          </details>
        </section>

        <div class="showcase-resource-links">
          <a class="resource-link" href="/wiki">
            <strong>Browse the Policy Wiki <span aria-hidden="true">›</span></strong>
            <span>Public information on German consumer policies and brands; not individual legal advice.</span>
          </a>
          <a class="resource-link" href="#mcp-playground">
            <strong>Explore the MCP Playground <span aria-hidden="true">›</span></strong>
            <span>Explore public MCP examples using fictional sample data.</span>
          </a>
        </div>
      </div>
    </section>

    <!-- URGENT ATTENTION NOTIFICATION BANNER -->
    <div class="layout-container" style="margin-top: var(--space-8);">
      <div id="urgent-attention-widget" role="region" aria-label="Upcoming reminders"></div>
    </div>

    <!-- SPLIT-SCREEN MCP PLAYGROUND (FEATURE 5) -->
    <section id="mcp-playground" class="playground-section">
      <div class="layout-container">
        <div class="section-header">
          <span class="section-tag">FEATURE 5 · INTERACTIVE BENCHMARK</span>
          <h2 class="section-title">Split-Screen MCP Protocol Playground</h2>
          <p class="section-subtitle text-muted">
            Explore tool calls through the client-side mock MCP transport or Cloudflare edge worker.
            Actions in the app simulator appear in the protocol stream. The simulator uses sample data.
          </p>
        </div>

        <div class="playground-grid">
          <!-- Left Sub-Panel: MCP Protocol Console -->
          <div class="mcp-console-panel card">
            <div class="panel-header-row">
              <div class="font-bold">⚡ MCP Wire Protocol Console</div>
              <div id="mcp-latency-badge" class="latency-badge status-protected">
                🟢 <strong>4.2ms</strong> <span class="badge-label">(sample latency)</span>
              </div>
            </div>

            <div class="controls-row">
              <div class="form-group">
                <label for="mcp-tool-select">SELECT AN MCP TOOL</label>
                <select id="mcp-tool-select" class="form-select">
                  <option value="policy_lookup">policy_lookup (BGB Policy &amp; § 312k Button)</option>
                  <option value="claim_dossier_generate">claim_dossier_generate (§ 437 defect notice)</option>
                  <option value="tools/list">tools/list (MCP Introspection)</option>
                </select>
              </div>

              <div class="form-group">
                <label for="mcp-preset-select">LOAD AN EXAMPLE SCENARIO</label>
                <select id="mcp-preset-select" class="form-select">
                  <option value="spotify">Spotify Student cancellation (§ 312k)</option>
                  <option value="apple_macbook">Apple MacBook Pro 16 M3 defect notice (§ 437)</option>
                  <option value="sony_headphones">Sony WH-1000XM5 month 11 (§ 477)</option>
                  <option value="tools_list">tools/list inspection</option>
                </select>
              </div>
            </div>

            <div class="form-group">
              <label for="mcp-args-editor">JSON-RPC ARGUMENTS</label>
              <textarea id="mcp-args-editor" class="form-textarea" spellcheck="false"></textarea>
            </div>

            <div class="actions-bar">
              <div class="actions-left">
                <button id="mcp-run-btn" class="btn-compact btn-primary">
                  ▶ Run tool call
                </button>
                <button id="mcp-copy-curl-btn" class="btn-compact btn-outline">
                  📋 cURL kopieren
                </button>
              </div>
              <div class="actions-right">
                <button id="mcp-open-claude-btn" class="btn-compact btn-outline">
                  ⚙ Open in Claude Desktop
                </button>
                <button id="mcp-clear-stream-btn" class="btn-compact btn-outline" title="Clear stream">
                  🧹 Clear
                </button>
              </div>
            </div>

            <!-- Wire Protocol Streamer -->
            <div class="stream-output-wrapper" id="mcp-stream-output" aria-live="polite">
              <div class="stream-empty">Ready for JSON-RPC 2.0 calls. Select a tool and run it to see the sample exchange.</div>
            </div>
          </div>

          <!-- Right Sub-Panel: Live App Simulator -->
          <div class="app-simulator-panel card" id="app-simulator-root"></div>
        </div>
      </div>
    </section>

    <!-- SHOWCASE UNIFIED OMNIBAR SEARCH (FEATURE 10) -->
    <section id="omnibar-section" class="omnibar-section">
      <div class="layout-container">
        <div class="section-header">
          <span class="section-tag">FEATURE 10 · UNIVERSAL OMNIBAR</span>
          <h2 class="section-title">Multi-domain search sandbox</h2>
          <p class="section-subtitle text-muted">
            Search 20 curated brand policies and sample wallet receipts, or type <code>&gt;</code> for commands such as <code>&gt;claim</code>, <code>&gt;cancel</code>, and <code>&gt;tax</code>.
          </p>
        </div>

        <div id="showcase-omnibar-root"></div>
      </div>
    </section>

    <!-- THREE DISTINCT CALENDAR ARCHITECTURES (FEATURES 7, 8, 9) -->
    <section id="calendars-section" class="calendar-section">
      <div class="layout-container">
        <div id="calendar-suite-root"></div>
      </div>
    </section>

    <!-- MODULAR DASHBOARD WIDGETS (FEATURE 6, 18) -->
    <section id="dashboard-widgets" class="widgets-section">
      <div class="layout-container">
        <div class="section-header">
          <span class="section-tag">FEATURES 6 &amp; 18 · MODULAR DASHBOARD</span>
          <h2 class="section-title">Spending, tax, and GoBD receipt records</h2>
          <p class="section-subtitle text-muted">
            Receipt hashes and an overview of eligible immediate deductions.
          </p>
        </div>

        <div class="widgets-grid">
          <div id="spend-radar-widget"></div>
          <div id="gobd-feed-widget" style="grid-column: span 2;"></div>
        </div>
      </div>
    </section>

    <!-- SAFE-HARBOR LEGAL NOTICE (BGH VIII ZR 285/18) -->
    <section class="safe-harbor-section">
      <div class="layout-container">
        <div id="safe-harbor-footer-root"></div>
      </div>
    </section>

  </main>

  <!-- QUICK-CONNECT MODAL DIALOG -->
  <dialog id="quick-connect-modal" class="modal-dialog">
    <div class="modal-content card">
      <div class="modal-header">
        <h3 class="modal-title">⚡ AI Agent Quick-Connect Configuration</h3>
        <button class="modal-close-btn" data-action="close-modal" aria-label="Close">✕</button>
      </div>
      <div class="modal-body">
        <p class="text-muted text-sm">
          Connect the Rights &amp; Renewals Model Context Protocol (MCP) server to your preferred AI development environment.
        </p>

        <div class="config-tabs">
          <div class="config-section">
            <h4 class="font-bold">Claude Desktop</h4>
            <pre class="code-block"><code>{`{
  "mcpServers": {
    "rights-and-renewals": {
      "command": "npx",
      "args": ["-y", "mcp-remote", "https://rightsandrenewals.pages.dev/api/mcp"]
    }
  }
}`}</code></pre>
          </div>

          <div class="config-section" style="margin-top: var(--space-4);">
            <h4 class="font-bold">Cursor IDE</h4>
            <pre class="code-block"><code>{`{
  "mcpServers": {
    "rights-and-renewals": {
      "url": "https://rightsandrenewals.pages.dev/api/mcp"
    }
  }
}`}</code></pre>
          </div>
        </div>
      </div>
      <div class="modal-footer" style="display: flex; justify-content: space-between; align-items: center;">
        <a href="/agent-setup" class="btn btn-primary" style="font-size: 0.88rem;">View agent setup →</a>
        <button class="btn btn-outline" data-action="close-modal">Close</button>
      </div>
    </div>
  </dialog>

  <!-- Initialize Client Controllers -->
  <script>
    import '../main.js';
    import '../components/webmcp.ts';

    document.querySelectorAll('.mobile-nav-panel a[href^="#"]').forEach((link) => {
      link.addEventListener('click', () => {
        const menu = link.closest('details');
        if (menu) menu.open = false;
      });
    });
  </script>
</body>
</html>
