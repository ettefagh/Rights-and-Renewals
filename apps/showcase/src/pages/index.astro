---
import '../../styles/tokens.css';
import '../../styles/main.css';
import '../../styles/homepage.css';
import AudienceSwitch from '../components/AudienceSwitch.astro';
import { ArrowUpRight, CalendarDays, ChevronRight, Menu, ReceiptText, RefreshCw, ShieldCheck } from 'lucide-svelte';

export const prerender = false;

---

<!DOCTYPE html>
<html lang="en" data-theme="light">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
  <title>Rights &amp; Renewals · Receipts, subscriptions and consumer policies</title>
  <meta name="description" content="Save receipts on your device, track warranty and renewal dates, and look up consumer policies for purchases and subscriptions in Germany." />
  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  <link rel="icon" type="image/png" sizes="64x64" href="/favicon.png" />
  <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />

  <!-- AI-Agent Discovery Standards Links (RFC 8288 / ARD / SEP-2127 / AgentSkills) -->
  <link rel="ai-catalog" href="/.well-known/ai-catalog.json" />
  <link rel="mcp-server-card" href="/.well-known/mcp/server-card.json" />
  <link rel="agent-skills" href="/.well-known/agent-skills/index.json" />
  <link rel="service-desc" href="/api/mcp" />

  <!-- Zero-FOUC Theme Initialization -->
  <script is:inline>
    (function() {
      try {
        const saved = localStorage.getItem('cmlab-theme');
        const systemDark = window.matchMedia && window.matchMedia('(prefers-color-scheme: dark)').matches;
        document.documentElement.setAttribute('data-theme', saved || (systemDark ? 'dark' : 'light'));
      } catch (e) {}
    })();

    window.toggleTheme = function() {
      const current = document.documentElement.getAttribute('data-theme');
      const next = current === 'dark' ? 'light' : 'dark';
      document.documentElement.setAttribute('data-theme', next);
      try { localStorage.setItem('cmlab-theme', next); } catch (e) {}
    };
  </script>

  <!-- W3C DTCG 3-Tier Design System Stylesheets -->
  <link rel="stylesheet" href="/styles/tokens.css" />
  <link rel="stylesheet" href="/styles/main.css" />
</head>
<body class="showcase-shell showcase-home">
  <a class="home-skip" href="#showcase-main">Skip to content</a>

  <!-- ========================================================================
       STICKY UTILITY HEADER
       ======================================================================== -->
  <header role="banner" id="app-header" class="showcase-header">
    <div class="layout-container header-inner">
      <a href="/" class="brand-link" aria-label="Rights & Renewals Home" style="display: inline-flex; align-items: center; gap: 10px;">
        <img src="/favicon.svg" alt="Rights & Renewals Icon" width="32" height="32" style="border-radius: 8px; display: block;" />
        <span class="brand-name">Rights &amp; Renewals</span>
      </a>

      <nav class="nav-links" aria-label="Main Navigation">
        <a href="#wallet-demo" class="nav-item">Wallet demo</a>
        <a href="/wiki" class="nav-item">Policy Wiki</a>
        <a href="#mcp-playground" class="nav-item">MCP Playground</a>
        <a href="/agent-setup" class="nav-item" data-action="open-quick-connect" id="header-connect-btn">Agent setup</a>
      </nav>

      <div class="nav-actions">
        <button class="theme-toggle-btn" id="theme-toggle-btn" onclick="window.toggleTheme()" aria-label="Toggle theme" title="Toggle theme">
          <span class="theme-icon" aria-hidden="true">🌙</span>
        </button>
        <a href="https://rightsandrenewals-app.pages.dev/" data-legacy-url="https://app.cm-lab.pages.dev/" class="btn-compact btn-primary" target="_blank" rel="noopener noreferrer">
          Open wallet ↗
        </a>
      </div>
      <details class="mobile-nav">
        <summary aria-label="Menu"><Menu size={24} aria-hidden="true" /><span class="sr-only">Menu</span></summary>
        <nav class="mobile-nav-panel" aria-label="Mobile navigation">
          <a href="#wallet-demo">Wallet demo</a>
          <a href="/wiki">Policy Wiki</a>
          <a href="#mcp-playground">MCP Playground</a>
          <a href="/agent-setup">Agent setup</a>
        </nav>
      </details>
    </div>
  </header>

  <!-- ========================================================================
       MAIN SHOWCASE CONTENT
       ======================================================================== -->
  <main id="showcase-main">
    <AudienceSwitch humanHref="/" machineHref="/machine/view/home" />

    <section id="hero" class="home-hero" aria-labelledby="home-title">
      <div class="layout-container home-hero-grid">
        <div class="home-intro">
          <p class="home-kicker">Your purchase and subscription wallet</p>
          <h1 id="home-title">Keep track of what you buy and what renews.</h1>
          <p class="home-deck">Save receipts, see upcoming dates, and find out what to do when you need to cancel a subscription or report a faulty purchase.</p>
          <div class="home-actions">
            <a href="https://rightsandrenewals-app.pages.dev/" data-legacy-url="https://app.cm-lab.pages.dev/" class="btn btn-primary" target="_blank" rel="noopener noreferrer">Open the wallet <ArrowUpRight size={18} aria-hidden="true" /></a>
            <a href="#wallet-demo" class="btn btn-outline">Explore the demo</a>
          </div>
          <p class="home-note"><ShieldCheck size={19} aria-hidden="true" /> Your receipts stay on your device.</p>
        </div>

        <section id="wallet-demo" class="home-demo" aria-labelledby="sample-preview-title">
          <div class="home-demo-head">
            <span class="home-demo-label">Wallet preview</span>
            <span class="home-demo-badge">Sample data</span>
          </div>
          <h2 id="sample-preview-title">What’s coming up</h2>
          <div class="home-demo-list">
            <details class="home-event">
              <summary><CalendarDays size={22} aria-hidden="true" /><span><strong>Gym membership</strong><small>Cancellation deadline in 3 days</small></span><ChevronRight size={18} aria-hidden="true" /></summary>
              <p>Check the deadline before you decide whether to keep or cancel a membership.</p>
            </details>
            <details class="home-event">
              <summary><RefreshCw size={22} aria-hidden="true" /><span><strong>Music subscription</strong><small>Renews in 5 days</small></span><ChevronRight size={18} aria-hidden="true" /></summary>
              <p>See when the next billing period starts so you can review the subscription in time.</p>
            </details>
            <details class="home-event">
              <summary><ReceiptText size={22} aria-hidden="true" /><span><strong>Headphones</strong><small>Warranty date in 3 weeks</small></span><ChevronRight size={18} aria-hidden="true" /></summary>
              <p>Open the purchase to find its receipt and review the dates you saved.</p>
            </details>
          </div>
        </section>
      </div>
    </section>

    <section class="home-guide" aria-labelledby="home-guide-title">
      <div class="layout-container">
        <p class="home-kicker">How the wallet works</p>
        <h2 id="home-guide-title">Find the receipt and decide what to do next</h2>
        <ol class="home-steps">
          <li><span class="home-step-number" aria-hidden="true">01</span><h3>Save a purchase</h3><p>Add a purchase or subscription and attach a photo of the receipt if you have one.</p></li>
          <li><span class="home-step-number" aria-hidden="true">02</span><h3>See what’s coming up</h3><p>Review upcoming dates alongside the purchases and subscriptions they belong to.</p></li>
          <li><span class="home-step-number" aria-hidden="true">03</span><h3>Prepare your next step</h3><p>Find the provider’s information or prepare a cancellation or claim draft to review before sending.</p></li>
        </ol>
      </div>
    </section>

    <section class="home-reference" aria-label="Public tools and resources">
      <div class="layout-container home-reference-grid">
        <article class="home-reference-item">
          <p class="home-kicker">Policy Wiki</p>
          <h2>Look up a brand’s policy</h2>
          <p>Find cancellation and warranty information for brands and services in Germany.</p>
          <a href="/wiki">Browse the Policy Wiki <ChevronRight size={18} aria-hidden="true" /></a>
        </article>
        <article class="home-reference-item">
          <p class="home-kicker">Developer tools</p>
          <h2>Try the MCP server</h2>
          <p>Run a policy lookup or draft a sample notice. The playground shows the JSON-RPC request and response.</p>
          <a href="#mcp-playground">Open the MCP Playground <ChevronRight size={18} aria-hidden="true" /></a>
          <a href="/agent-setup">Set up your agent <ChevronRight size={18} aria-hidden="true" /></a>
        </article>
      </div>
    </section>

    <!-- URGENT ATTENTION NOTIFICATION BANNER -->
    <div class="layout-container" style="margin-top: var(--space-8);">
      <div id="urgent-attention-widget" role="region" aria-label="Upcoming reminders"></div>
    </div>

    <!-- SPLIT-SCREEN MCP PLAYGROUND (FEATURE 5) -->
    <section id="mcp-playground" class="playground-section home-lab">
      <div class="layout-container">
        <div class="section-header">
          <span class="section-tag">Developer sandbox</span>
          <h2 class="section-title">MCP Playground</h2>
          <p class="section-subtitle text-muted">
            Run a simulated request with sample data and inspect the exchange. Copy the cURL command to try the live endpoint.
          </p>
        </div>

        <div class="playground-grid">
          <!-- Left Sub-Panel: MCP Protocol Console -->
          <div class="mcp-console-panel card">
            <div class="panel-header-row">
              <div class="font-bold">Request console · local mock</div>
              <div id="mcp-latency-badge" class="latency-badge status-protected">
                Ready to run
              </div>
            </div>

            <div class="controls-row">
              <div class="form-group">
                <label for="mcp-tool-select">Tool</label>
                <select id="mcp-tool-select" class="form-select">
                  <option value="policy_lookup">policy_lookup (sample catalog)</option>
                  <option value="statutory_law_lookup">statutory_law_lookup (sample statute reference)</option>
                  <option value="subscription_category_rules">subscription_category_rules (sample rules)</option>
                  <option value="tools/list">tools/list (MCP Introspection)</option>
                </select>
              </div>

              <div class="form-group">
                <label for="mcp-preset-select">Example</label>
                <select id="mcp-preset-select" class="form-select">
                  <option value="spotify">Spotify policy sample (local data)</option>
                  <option value="law_477">BGB § 477 reference (sample)</option>
                  <option value="subscription_rules">Subscription rules (sample)</option>
                  <option value="tools_list">tools/list inspection</option>
                </select>
              </div>
            </div>

            <div class="form-group">
              <label for="mcp-args-editor">Arguments (JSON)</label>
              <textarea id="mcp-args-editor" class="form-textarea" spellcheck="false"></textarea>
            </div>

            <div class="actions-bar">
              <div class="actions-left">
                <button id="mcp-run-btn" class="btn-compact btn-primary">
                  Run request
                </button>
                <button id="mcp-copy-curl-btn" class="btn-compact btn-outline">
                  Copy cURL
                </button>
              </div>
              <div class="actions-right">
                <button id="mcp-open-claude-btn" class="btn-compact btn-outline">
                  Open in Claude Desktop
                </button>
                <button id="mcp-clear-stream-btn" class="btn-compact btn-outline" title="Clear stream">
                  Clear results
                </button>
              </div>
            </div>

            <!-- Wire Protocol Streamer -->
            <div class="stream-output-wrapper" id="mcp-stream-output" aria-live="polite">
              <div class="stream-empty">Local mock only · sample data, not a live response. Select a tool to inspect the exchange.</div>
            </div>
          </div>

          <!-- Right Sub-Panel: Live App Simulator -->
          <div class="app-simulator-panel card" id="app-simulator-root"></div>
        </div>
      </div>
    </section>

    <!-- SHOWCASE UNIFIED OMNIBAR SEARCH (FEATURE 10) -->
    <section id="omnibar-section" class="omnibar-section home-lab">
      <div class="layout-container">
        <div class="section-header">
          <span class="section-tag">Sample wallet tools</span>
          <h2 class="section-title">Search the sample wallet</h2>
          <p class="section-subtitle text-muted">
            Search brand policies and example entries, or try a command such as <code>&gt;cancel</code>.
          </p>
        </div>

        <div id="showcase-omnibar-root"></div>
      </div>
    </section>

    <!-- THREE DISTINCT CALENDAR ARCHITECTURES (FEATURES 7, 8, 9) -->
    <section id="calendars-section" class="calendar-section home-lab">
      <div class="layout-container">
        <div id="calendar-suite-root"></div>
      </div>
    </section>

    <!-- MODULAR DASHBOARD WIDGETS (FEATURE 6, 18) -->
    <section id="dashboard-widgets" class="widgets-section home-lab">
      <div class="layout-container">
        <div class="section-header">
          <span class="section-tag">Sample wallet tools</span>
          <h2 class="section-title">Review spending and receipt records</h2>
          <p class="section-subtitle text-muted">
            See how the wallet can organize spending and receipt records for your own review.
          </p>
        </div>

        <div class="widgets-grid">
          <div id="spend-radar-widget"></div>
          <div id="gobd-feed-widget"></div>
        </div>
      </div>
    </section>

    <!-- SAFE-HARBOR LEGAL NOTICE (BGH VIII ZR 285/18) -->
    <section class="safe-harbor-section">
      <div class="layout-container">
        <div id="safe-harbor-footer-root"></div>
      </div>
    </section>

  </main>

  <footer class="home-footer">
    <div class="layout-container home-footer-inner">
      <a href="/">Rights &amp; Renewals</a>
      <nav aria-label="Footer navigation">
        <a href="/wiki">Policy Wiki</a>
        <a href="/agent-setup">Agent setup</a>
        <a href="/emdash">EmDash CMS</a>
      </nav>
    </div>
  </footer>

  <!-- QUICK-CONNECT MODAL DIALOG -->
  <dialog id="quick-connect-modal" class="modal-dialog">
    <div class="modal-content card">
      <div class="modal-header">
        <h3 class="modal-title">Connect an agent</h3>
        <button class="modal-close-btn" data-action="close-modal" aria-label="Close">✕</button>
      </div>
      <div class="modal-body">
        <p class="text-muted text-sm">
          Connect the Rights &amp; Renewals Model Context Protocol (MCP) server to your preferred AI development environment.
        </p>

        <div class="config-tabs">
          <div class="config-section">
            <h4 class="font-bold">Claude Desktop</h4>
            <pre class="code-block"><code>{`{
  "mcpServers": {
    "rights-and-renewals": {
      "command": "npx",
      "args": ["-y", "mcp-remote", "https://rightsandrenewals.pages.dev/api/mcp"]
    }
  }
}`}</code></pre>
          </div>

          <div class="config-section" style="margin-top: var(--space-4);">
            <h4 class="font-bold">Cursor IDE</h4>
            <pre class="code-block"><code>{`{
  "mcpServers": {
    "rights-and-renewals": {
      "url": "https://rightsandrenewals.pages.dev/api/mcp"
    }
  }
}`}</code></pre>
          </div>
        </div>
      </div>
      <div class="modal-footer" style="display: flex; justify-content: space-between; align-items: center;">
        <a href="/agent-setup" class="btn btn-primary" style="font-size: 0.88rem;">View agent setup →</a>
        <button class="btn btn-outline" data-action="close-modal">Close</button>
      </div>
    </div>
  </dialog>

  <!-- Initialize Client Controllers -->
  <script>
    import '../main.js';
    import '../components/webmcp.ts';

    document.querySelectorAll('.mobile-nav-panel a[href^="#"]').forEach((link) => {
      link.addEventListener('click', () => {
        const menu = link.closest('details');
        if (menu) menu.open = false;
      });
    });
  </script>
</body>
</html>
