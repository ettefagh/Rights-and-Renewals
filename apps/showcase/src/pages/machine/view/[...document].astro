---
import AudienceSwitch from '../../../components/AudienceSwitch.astro';
import { getMachineDocument } from '../../../data/machine-documents';
import '../../../../styles/tokens.css';
import '../../../../styles/main.css';
import '../../../../styles/machine-reader.css';

export const prerender = false;

const path = Astro.params.document;
const document = await getMachineDocument(path === 'home' ? path : path && path + '.md');
if (!document) Astro.response.status = 404;
---

<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="robots" content="noindex" />
    <title>{document ? document.title + ' | Markdown' : 'Document not found'}</title>
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    {document && <link rel="alternate" type="text/markdown" href={document.rawHref} />}
  </head>
  <body class="showcase-shell machine-reader-page">
    <main class="machine-reader-shell">
      <header class="machine-reader-header">
        <a class="machine-brand" href="/" aria-label="Rights & Renewals home">
          <img src="/favicon.svg" width="34" height="34" alt="" />
          <span>Rights &amp; Renewals</span>
        </a>
        <p class="machine-reader-kicker">Machine readable document</p>
        <div class="machine-reader-title-row">
          <h1>{document?.title ?? 'Document not found'}</h1>
          {document && <a class="raw-link" href={document.rawHref} type="text/markdown">Raw Markdown</a>}
        </div>
        <p class="machine-reader-description">This view displays the document source as Markdown. Switch back to the human view for the formatted page.</p>
      </header>
      <section class="machine-document" aria-label="Markdown source">
        <pre><code>{document?.markdown ?? '# Document not found'}</code></pre>
      </section>
    </main>
    <AudienceSwitch humanHref={document?.humanHref ?? '/'} machineHref={Astro.url.pathname} active="machine" />
  </body>
</html>
