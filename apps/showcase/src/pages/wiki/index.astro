---
import type { PolicyWikiEntry } from '@cmlab/core';
import { getPublishedPolicies } from '../../lib/policy-cms.js';
import BrandIcon from '../../components/BrandIcon.svelte';
import AudienceSwitch from '../../components/AudienceSwitch.astro';
import TelemetryConsent from '../../components/TelemetryConsent.astro';
import { policyTelemetryMetadata, wikiTelemetryMetadata } from '../../lib/telemetry-page-metadata.js';
import { ChevronRight, Menu, Search } from 'lucide-svelte';
import '../../../styles/tokens.css';
import '../../../styles/main.css';
import '../../../styles/policy-wiki.css';

export const prerender = false;

Astro.response.headers.set('Cache-Control', 'no-store');

let policies: PolicyWikiEntry[] = [];
let cmsUnavailable = false;
try {
  policies = await getPublishedPolicies();
} catch (error) {
  console.error('[policy-wiki] EmDash published content is unavailable.', error);
  Astro.response.status = 503;
  cmsUnavailable = true;
}

const subscriptions = policies.filter((b) => b.category === 'subscription');
const hardware = policies.filter((b) => b.category === 'hardware');
const wikiTelemetry = await wikiTelemetryMetadata();
const policyTelemetry = new Map(await Promise.all(policies.map(async (policy) => [
  policy.brandSlug,
  await policyTelemetryMetadata(policy),
] as const)));
const policySearchText = (brand: PolicyWikiEntry) =>
  [brand.brandName, brand.brandSlug, brand.category, brand.legalNotes, ...(brand.searchAliases ?? [])]
    .filter(Boolean)
    .join(' ')
    .toLocaleLowerCase('de');
---

<!DOCTYPE html>
<html lang="en" data-theme="light">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
  <title>Rights &amp; Renewals · Brand Policy Wiki · 20 brands</title>
  <meta name="description" content="Public information about cancellation periods and statutory warranty rules for 20 brands in Germany." />
  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  <link rel="icon" type="image/png" sizes="64x64" href="/favicon.png" />
  <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />

  <script is:inline>
    (function() {
      try {
        const saved = localStorage.getItem('cmlab-theme');
        const systemDark = window.matchMedia && window.matchMedia('(prefers-color-scheme: dark)').matches;
        document.documentElement.setAttribute('data-theme', saved || (systemDark ? 'dark' : 'light'));
      } catch (e) {}
    })();
  </script>

  <link rel="stylesheet" href="/styles/tokens.css" />
  <link rel="stylesheet" href="/styles/main.css" />

  <style>
    .wiki-container {
      max-width: 1100px;
      margin: 0 auto;
      padding: var(--space-8, 32px) var(--space-4, 16px) var(--space-16, 64px);
    }
    .wiki-hero {
      text-align: center;
      margin-bottom: var(--space-10, 40px);
    }
    .wiki-hero h1 {
      font-size: var(--font-size-4xl, 36px);
      font-weight: 800;
      letter-spacing: -0.02em;
      margin-bottom: var(--space-3, 12px);
      color: var(--color-text-primary, #0F1C19);
    }
    .wiki-hero p {
      font-size: var(--font-size-lg, 18px);
      color: var(--color-text-secondary, #475569);
      max-width: 720px;
      margin: 0 auto;
    }
    .category-section-title {
      font-size: var(--font-size-2xl, 24px);
      font-weight: 700;
      letter-spacing: -0.015em;
      margin: var(--space-8, 32px) 0 var(--space-4, 16px);
      color: var(--color-text-primary, #0F1C19);
      display: flex;
      align-items: center;
      gap: var(--space-2, 8px);
    }
    .brand-grid {
      display: grid;
      grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
      gap: var(--space-4, 16px);
    }
    .brand-card {
      background: var(--color-surface-card);
      border: 1px solid var(--color-border-subtle);
      border-radius: var(--radius-xl);
      padding: var(--space-5);
      display: flex;
      flex-direction: column;
      gap: var(--space-3);
      text-decoration: none;
      color: inherit;
      transition: transform 180ms cubic-bezier(0.16, 1, 0.3, 1), box-shadow 180ms ease, border-color 180ms ease;
    }
    .brand-card:hover {
      transform: translateY(-2px);
      box-shadow: var(--elevation-md);
      border-color: var(--color-brand-primary);
    }
    .brand-card:active {
      transform: scale(0.98) translateY(1px);
    }
    .brand-card-top {
      display: flex;
      align-items: center;
      gap: var(--space-3, 12px);
    }
    .brand-card-avatar {
      width: 44px;
      height: 44px;
      border-radius: var(--radius-md, 8px);
      background: var(--color-surface-subtle, #F1F5F9);
      display: flex;
      align-items: center;
      justify-content: center;
      color: var(--color-primary-teal, #2F524C);
      flex-shrink: 0;
      border: 1px solid var(--color-border-subtle, #E2E8F0);
    }
    .brand-card-name {
      font-size: var(--font-size-md, 16px);
      font-weight: 700;
      color: var(--color-text-primary, #0F1C19);
      margin: 0;
    }
    .brand-card-category {
      font-size: 12px;
      color: var(--color-text-muted, #64748B);
    }
    .brand-card-meta {
      font-size: 13px;
      color: var(--color-text-secondary, #334155);
      line-height: 1.4;
      flex: 1;
    }
    .brand-card-action {
      display: flex;
      align-items: center;
      justify-content: space-between;
      font-size: 13px;
      font-weight: 600;
      color: var(--color-primary-teal, #2F524C);
      padding-top: var(--space-2, 8px);
      border-top: 1px solid var(--color-border-subtle, #E2E8F0);
    }
  </style>
</head>
<body class="showcase-shell policy-wiki-page">

  <!-- Header -->
  <header role="banner" id="app-header" class="showcase-header">
    <div class="layout-container header-inner">
      <a href="/" class="brand-link" aria-label="Rights & Renewals Home">
        <img src="/favicon.svg" alt="Rights & Renewals Logo" width="32" height="32" style="border-radius: 8px; flex-shrink: 0;" />
        <span class="brand-name">Rights &amp; Renewals</span>
      </a>

      <nav class="nav-links" aria-label="Main Navigation">
        <a href="/#wallet-demo" class="nav-item">Wallet demo</a>
        <a href="/wiki" class="nav-item font-bold" aria-current="page">Policy Wiki</a>
        <a href="/emdash" class="nav-item">EmDash CMS</a>
        <a href="/#mcp-playground" class="nav-item">MCP Playground</a>
        <a href="/agent-setup" class="nav-item">Agent setup</a>
      </nav>

      <div class="nav-actions">
        <a href="https://rightsandrenewals-app.pages.dev/" data-legacy-url="https://app.cm-lab.pages.dev/" class="btn-compact btn-primary" target="_blank" rel="noopener noreferrer">
          Open wallet ↗
        </a>
      </div>
      <details class="mobile-nav">
        <summary aria-label="Menu"><Menu size={24} aria-hidden="true" /><span class="sr-only">Menu</span></summary>
        <nav class="mobile-nav-panel" aria-label="Mobile navigation">
          <a href="/#wallet-demo">Wallet demo</a>
          <a href="/wiki" aria-current="page">Policy Wiki</a>
          <a href="/emdash">EmDash CMS</a>
          <a href="/#mcp-playground">MCP Playground</a>
          <a href="/agent-setup">Agent setup</a>
          <a href="https://rightsandrenewals-app.pages.dev/" data-legacy-url="https://app.cm-lab.pages.dev/" target="_blank" rel="noopener noreferrer">Open wallet</a>
        </nav>
      </details>
    </div>
  </header>

  <main class="wiki-container" data-telemetry-page={wikiTelemetry.pageId} data-telemetry-revision={wikiTelemetry.revision}>
    <AudienceSwitch humanHref="/wiki/" machineHref="/machine/view/wiki" />
    <div class="wiki-hero">
      <p class="wiki-kicker">Public reference · {policies.length} brands</p>
      <h1>Brand Policy Wiki</h1>
      <p>
        Browse cancellation and warranty information for purchases and subscriptions in Germany. These public records are general information, not individual legal advice.
      </p>
    </div>

    <form class="wiki-search" id="wiki-search-form" role="search">
      <Search size={21} aria-hidden="true" />
      <label class="sr-only" for="wiki-search">Search brands and policies</label>
      <input id="wiki-search" type="search" placeholder="Search brands and policies" autocomplete="off" />
      <button type="reset" aria-label="Clear policy search">Clear</button>
    </form>
    {cmsUnavailable && <p role="status">Published policy content is temporarily unavailable.</p>}
    <p class="wiki-result-count" id="wiki-result-count" aria-live="polite">{policies.length} brands</p>

    <!-- Subscriptions Section -->
    <section class="policy-list-group" data-brand-group aria-labelledby="subscription-list-title">
      <h2 class="category-section-title" id="subscription-list-title">Subscriptions &amp; digital services <span>({subscriptions.length})</span></h2>
      <div class="policy-brand-list">
      {subscriptions.map((brand: PolicyWikiEntry) => (
        <a href={`/wiki/${brand.brandSlug}`} class="policy-brand-row" data-brand-row data-search={policySearchText(brand)} data-telemetry-policy-id={policyTelemetry.get(brand.brandSlug)?.entityId} data-telemetry-entity-revision={policyTelemetry.get(brand.brandSlug)?.revision}>
          <span class="policy-brand-mark" aria-hidden="true"><BrandIcon slug={brand.brandSlug} brandName={brand.brandName} logoUrl={brand.logoUrl} size={27} decorative /></span>
          <span class="policy-brand-main"><strong>{brand.brandName}</strong><small>Subscription · cancellation policy</small></span>
          <span class="policy-brand-meta">{brand.cancellationButtonCompliant ? '§ 312k button listed' : 'Policy status under review'}</span>
          <ChevronRight size={19} aria-hidden="true" />
        </a>
      ))}
      </div>
    </section>

    <!-- Hardware Section -->
    <section class="policy-list-group" data-brand-group aria-labelledby="hardware-list-title">
      <h2 class="category-section-title" id="hardware-list-title">Hardware &amp; electronics <span>({hardware.length})</span></h2>
      <div class="policy-brand-list">
      {hardware.map((brand: PolicyWikiEntry) => (
        <a href={`/wiki/${brand.brandSlug}`} class="policy-brand-row" data-brand-row data-search={policySearchText(brand)} data-telemetry-policy-id={policyTelemetry.get(brand.brandSlug)?.entityId} data-telemetry-entity-revision={policyTelemetry.get(brand.brandSlug)?.revision}>
          <span class="policy-brand-mark" aria-hidden="true"><BrandIcon slug={brand.brandSlug} brandName={brand.brandName} logoUrl={brand.logoUrl} size={27} decorative /></span>
          <span class="policy-brand-main"><strong>{brand.brandName}</strong><small>Purchase · statutory warranty</small></span>
          <span class="policy-brand-meta">{brand.statutoryWarrantyMonths} months · § 438 BGB</span>
          <ChevronRight size={19} aria-hidden="true" />
        </a>
      ))}
      </div>
    </section>
    <p class="wiki-empty" id="wiki-no-results" hidden>No matching brand or policy. Try another search.</p>
  </main>

  <script is:inline>
    (() => {
      const form = document.getElementById('wiki-search-form');
      const input = document.getElementById('wiki-search');
      const rows = Array.from(document.querySelectorAll('[data-brand-row]'));
      const groups = Array.from(document.querySelectorAll('[data-brand-group]'));
      const count = document.getElementById('wiki-result-count');
      const empty = document.getElementById('wiki-no-results');

      const filterPolicies = () => {
        const query = (input?.value || '').trim().toLocaleLowerCase('de');
        let visibleCount = 0;
        rows.forEach((row) => {
          const matches = !query || (row.dataset.search || '').includes(query);
          row.hidden = !matches;
          if (matches) visibleCount += 1;
        });
        groups.forEach((group) => {
          group.hidden = !group.querySelector('[data-brand-row]:not([hidden])');
        });
        if (count) count.textContent = `${visibleCount} ${visibleCount === 1 ? 'brand' : 'brands'}`;
        if (empty) empty.hidden = visibleCount !== 0;
      };

      input?.addEventListener('input', filterPolicies);
      form?.addEventListener('reset', () => setTimeout(filterPolicies, 0));
    })();
  </script>

  <TelemetryConsent />

</body>
</html>
