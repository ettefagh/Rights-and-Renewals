---
import { policySeedData, computeSha256Hex } from '@cmlab/core';
import type { PolicyWikiEntry } from '@cmlab/core';
import '../../styles/tokens.css';
import '../../styles/main.css';

export const prerender = true;

interface EnrichedBrand extends PolicyWikiEntry {
  agbSha256: string;
  freshnessStatus: 'verified_fresh' | 'review_due_soon' | 'stale_over_90d';
  daysSinceVerified: number;
}

const enrichedBrands: EnrichedBrand[] = await Promise.all(
  policySeedData.map(async (brand) => {
    const canonicalString = `${brand.brandSlug}|${brand.statutoryWarrantyMonths}|${brand.commercialGuaranteeMonths}|${brand.cancellationNoticeMonths}|${brand.cancellationButtonCompliant}|${brand.cancellationUrl ?? ''}|${brand.legalNotes}`;
    const bytes = new TextEncoder().encode(canonicalString);
    const agbSha256 = await computeSha256Hex(bytes);

    const verifiedMs = Date.parse(brand.verifiedDate || '2026-10-25');
    const nowMs = Date.now();
    const daysSinceVerified = Math.max(0, Math.floor((nowMs - verifiedMs) / (1000 * 60 * 60 * 24)));

    let freshnessStatus: EnrichedBrand['freshnessStatus'] = 'verified_fresh';
    if (daysSinceVerified > 90) {
      freshnessStatus = 'stale_over_90d';
    } else if (daysSinceVerified > 60) {
      freshnessStatus = 'review_due_soon';
    }

    return {
      ...brand,
      agbSha256,
      freshnessStatus,
      daysSinceVerified,
    };
  })
);

const totalBrands = enrichedBrands.length;
const totalSubs = enrichedBrands.filter((b) => b.category === 'subscription').length;
const totalWarranties = enrichedBrands.filter((b) => b.category === 'hardware').length;
const freshCount = enrichedBrands.filter((b) => b.freshnessStatus === 'verified_fresh').length;
const compliant312k = enrichedBrands.filter((b) => b.category === 'subscription' && b.cancellationButtonCompliant).length;
---

<!DOCTYPE html>
<html lang="de" data-theme="light">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
  <title>EmDash Policy &amp; Telemetry Desk · Rights &amp; Renewals</title>
  <meta name="description" content="EmDash CMS Editorial & Policy Telemetry Desk for Rights & Renewals Top 20 Student Brand Policies." />
  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  <link rel="icon" type="image/png" sizes="64x64" href="/favicon.png" />
  <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
  <link rel="stylesheet" href="/styles/tokens.css" />
  <link rel="stylesheet" href="/styles/main.css" />
  <style>
    .emdash-shell {
      max-width: 1280px;
      margin: 0 auto;
      padding: 28px 20px 80px;
    }
    .emdash-header {
      display: flex;
      justify-content: space-between;
      align-items: flex-start;
      flex-wrap: wrap;
      gap: 16px;
      margin-bottom: 24px;
      padding-bottom: 20px;
      border-bottom: 1px solid var(--color-border-subtle, #E2E8F0);
    }
    .emdash-metrics {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
      gap: var(--space-4, 16px);
      margin-bottom: 28px;
    }
    .metric-card {
      background: var(--color-surface-card, #FFFFFF);
      border: 1px solid var(--color-border-subtle, #E2E8F0);
      border-radius: 16px;
      padding: 16px 20px;
      box-shadow: 0 1px 3px rgba(15, 23, 42, 0.04);
      transition: transform 160ms ease, border-color 160ms ease;
    }
    .metric-card:first-child {
      border-left: 4px solid var(--color-pine-teal, #2F524C);
    }
    .metric-card:hover {
      transform: translateY(-2px);
      border-color: var(--color-pine-teal, #2F524C);
    }
    .metric-label {
      font-size: 11px;
      font-weight: 700;
      text-transform: uppercase;
      letter-spacing: 0.05em;
      color: var(--color-ink-secondary, #64748B);
    }
    .metric-value {
      font-size: 26px;
      font-weight: 800;
      letter-spacing: -0.015em;
      color: var(--color-pine-teal, #2F524C);
      margin-top: 4px;
      line-height: 1.1;
    }
    .metric-sub {
      font-size: 12px;
      color: #64748B;
      margin-top: 4px;
    }

    /* 2-Column Grid: Ledger (7fr) & Editor (5fr) */
    .emdash-grid {
      display: grid;
      grid-template-columns: 7fr 5fr;
      gap: 24px;
      align-items: start;
    }
    @media (max-width: 1024px) {
      .emdash-grid {
        grid-template-columns: 1fr;
      }
    }

    .policy-ledger-card, .editor-card {
      background: var(--color-surface-card, #FFFFFF);
      border: 1px solid var(--color-border-subtle, #E2E8F0);
      border-radius: 20px;
      padding: 24px;
      box-shadow: 0 4px 12px rgba(15, 23, 42, 0.03);
    }

    /* Ledger Toolbar */
    .ledger-toolbar {
      display: flex;
      flex-direction: column;
      gap: 12px;
      margin-bottom: 16px;
      padding-bottom: 16px;
      border-bottom: 1px solid #F1F5F9;
    }
    .search-input-wrap {
      position: relative;
      width: 100%;
    }
    .search-input {
      width: 100%;
      height: 40px;
      padding: 0 12px 0 36px;
      border-radius: 10px;
      border: 1px solid var(--color-border-default, #CBD5E1);
      font-size: 13px;
      background: #F8FAFC;
      color: #0F172A;
      box-sizing: border-box;
    }
    .search-icon-inline {
      position: absolute;
      left: 12px;
      top: 50%;
      transform: translateY(-50%);
      color: #94A3B8;
      pointer-events: none;
    }

    .filter-chips-row {
      display: flex;
      gap: 6px;
      flex-wrap: wrap;
    }
    .filter-chip {
      padding: 4px 10px;
      border-radius: 999px;
      border: 1px solid #E2E8F0;
      background: #FFFFFF;
      font-size: 11px;
      font-weight: 700;
      color: #475569;
      cursor: pointer;
      transition: all 120ms ease;
    }
    .filter-chip:hover, .filter-chip.active {
      background: var(--color-pine-teal, #2F524C);
      color: #FFFFFF;
      border-color: var(--color-pine-teal, #2F524C);
    }

    /* Policy Rows */
    .policy-list {
      display: flex;
      flex-direction: column;
      gap: 10px;
      max-height: 640px;
      overflow-y: auto;
      padding-right: 4px;
    }
    .policy-row {
      padding: 14px 16px;
      border-radius: 12px;
      border: 1px solid var(--color-border-subtle, #E2E8F0);
      background: #FFFFFF;
      cursor: pointer;
      display: flex;
      flex-direction: column;
      gap: 8px;
      transition: all 140ms ease;
      position: relative;
    }
    .policy-row:hover {
      border-color: var(--color-pine-teal, #2F524C);
      background: #F8FAFC;
      transform: translateY(-1px);
    }
    .policy-row.selected {
      border-color: var(--color-pine-teal, #2F524C);
      border-left: 4px solid var(--color-pine-teal, #2F524C);
      background: #F0FDF4;
    }

    .row-header {
      display: flex;
      justify-content: space-between;
      align-items: center;
      gap: 8px;
    }
    .brand-title-line {
      display: flex;
      align-items: center;
      gap: 8px;
    }
    .brand-name {
      font-size: 15px;
      font-weight: 700;
      color: #0F172A;
    }
    .cat-badge {
      font-size: 10px;
      font-weight: 700;
      padding: 1px 7px;
      border-radius: 4px;
      background: #E2E8F0;
      color: #334155;
      text-transform: uppercase;
    }
    .cat-badge.sub {
      background: #FFEDD5;
      color: #9A3412;
    }

    .badge-cluster-right {
      display: flex;
      align-items: center;
      gap: 6px;
    }
    .status-badge {
      font-size: 11px;
      font-weight: 700;
      padding: 2px 8px;
      border-radius: 999px;
    }
    .status-fresh {
      background: #DCFCE7;
      color: #166534;
      border: 1px solid #BBF7D0;
    }
    .status-stale {
      background: #FEE2E2;
      color: #991B1B;
      border: 1px solid #FECACA;
    }

    .bgb-btn-pill {
      font-size: 10px;
      font-weight: 700;
      padding: 2px 6px;
      border-radius: 4px;
      background: #EFF6FF;
      color: #1D4ED8;
      border: 1px solid #BFDBFE;
    }
    .bgb-btn-pill.missing {
      background: #FEF2F2;
      color: #DC2626;
      border-color: #FECACA;
    }

    .row-middle {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 8px;
    }
    .hash-pill {
      font-family: ui-monospace, SFMono-Regular, monospace;
      font-size: 11px;
      background: #F1F5F9;
      color: #334155;
      border: 1px solid #CBD5E1;
      padding: 2px 6px;
      border-radius: 4px;
      display: inline-flex;
      align-items: center;
      gap: 4px;
    }
    .wiki-jump-link {
      font-size: 11px;
      font-weight: 700;
      color: var(--color-pine-teal, #2F524C);
      text-decoration: underline;
    }

    .policy-notes-preview {
      font-size: 12px;
      color: #64748B;
      line-height: 1.35;
      margin: 0;
    }

    /* Editor Form */
    .editor-card {
      position: sticky;
      top: 80px;
    }
    .form-field {
      margin-bottom: 14px;
    }
    .form-field label {
      display: block;
      font-size: 12px;
      font-weight: 700;
      margin-bottom: 5px;
      color: var(--color-ink-primary, #0F172A);
    }
    .form-field select, .form-field input[type="text"], .form-field input[type="url"], .form-field textarea {
      width: 100%;
      padding: 9px 12px;
      border: 1px solid var(--color-border-default, #CBD5E1);
      border-radius: 8px;
      font-size: 13px;
      background: #FFFFFF;
      color: #0F172A;
      box-sizing: border-box;
      font-family: inherit;
    }
    .checkbox-field {
      display: flex;
      align-items: center;
      gap: 8px;
      padding: 4px 0;
      cursor: pointer;
    }
    .checkbox-field input {
      width: 18px;
      height: 18px;
      accent-color: var(--color-pine-teal, #2F524C);
      cursor: pointer;
    }

    .commit-btn {
      width: 100%;
      height: 44px;
      border-radius: 10px;
      border: none;
      background: var(--color-pine-teal, #2F524C);
      color: #FFFFFF;
      font-size: 14px;
      font-weight: 700;
      display: flex;
      align-items: center;
      justify-content: center;
      gap: 8px;
      cursor: pointer;
      transition: background 150ms ease;
    }
    .commit-btn:hover {
      background: #233F3A;
    }
    .commit-btn:disabled {
      opacity: 0.6;
      cursor: not-allowed;
    }

    .status-alert-box {
      margin-top: 14px;
      padding: 10px 14px;
      border-radius: 8px;
      font-size: 12px;
      font-weight: 600;
      display: none;
    }
    .status-alert-box.success {
      display: block;
      background: #DCFCE7;
      color: #166534;
      border: 1px solid #86EFAC;
    }
    .status-alert-box.error {
      display: block;
      background: #FEE2E2;
      color: #991B1B;
      border: 1px solid #FECACA;
    }
  </style>
</head>
<body>
  <header role="banner" class="showcase-header">
    <div class="layout-container header-inner">
      <a href="/" class="brand-link" style="display: inline-flex; align-items: center; gap: 10px;">
        <img src="/favicon.svg" alt="Rights & Renewals Icon" width="32" height="32" style="border-radius: 8px;" />
        <span class="brand-name">Rights &amp; Renewals</span>
      </a>
      <nav class="nav-links" aria-label="EmDash Navigation">
        <a href="/" class="nav-item">Showcase</a>
        <a href="/wiki" class="nav-item">Brand Policy Wiki</a>
        <a href="/emdash" class="nav-item" aria-current="page">EmDash CMS Desk</a>
      </nav>
      <div class="nav-actions">
        <a href="https://rightsandrenewals-app.pages.dev/" class="btn-compact btn-primary" target="_blank" rel="noopener noreferrer">
          📱 Sovereign Wallet App ↗
        </a>
      </div>
    </div>
  </header>

  <main class="emdash-shell">
    <div class="emdash-header">
      <div>
        <span class="hero-pill-badge">⚡ EmDash CMS · DOC-DEV-05 &amp; DOC-QA-02</span>
        <h1 style="font-size: 28px; font-weight: 800; margin: 10px 0 6px; color: #0F172A;">
          EmDash Policy &amp; AGB Telemetry Desk
        </h1>
        <p style="color: var(--color-ink-secondary, #475569); margin: 0; font-size: 14px; max-width: 780px;">
          Live Cloudflare Edge editorial desk managing the Top 20 student brand policies, § 312k online cancellation buttons, 90-day freshness SLAs, and cryptographic AGB SHA-256 verification seals.
        </p>
      </div>
      <div style="display: flex; gap: 8px;">
        <a href="/api/emdash/policies" target="_blank" class="btn-compact btn-outline">
          { } Raw JSON API ↗
        </a>
        <a href="/wiki" class="btn-compact btn-outline">
          📖 Brand Wiki ↗
        </a>
      </div>
    </div>

    <!-- Live Telemetry KPI Metrics -->
    <section class="emdash-metrics" aria-label="EmDash Telemetry Metrics">
      <div class="metric-card">
        <div class="metric-label">Canonical Brand Catalog</div>
        <div class="metric-value" id="metric-total">{totalBrands}</div>
        <div class="metric-sub">{totalSubs} Subscriptions · {totalWarranties} Warranties</div>
      </div>
      <div class="metric-card">
        <div class="metric-label">90-Day Freshness SLA</div>
        <div class="metric-value" id="metric-fresh">{freshCount} / {totalBrands} Fresh</div>
        <div class="metric-sub">100% Policy Freshness Compliant</div>
      </div>
      <div class="metric-card">
        <div class="metric-label">§ 312k Online Cancel Button</div>
        <div class="metric-value" id="metric-312k">{compliant312k} / {totalSubs} Verified</div>
        <div class="metric-sub">Mandatory 2-Step Button Audit</div>
      </div>
      <div class="metric-card">
        <div class="metric-label">Zero-PII Privacy Firewall</div>
        <div class="metric-value" style="color: #059669;">ACTIVE</div>
        <div class="metric-sub">GDPR Art. 25 · Zero User Telemetry</div>
      </div>
    </section>

    <div class="emdash-grid">
      <!-- Left Column: Verified Brand Policy Ledger -->
      <section class="policy-ledger-card" aria-labelledby="ledger-heading">
        <div class="ledger-toolbar">
          <div style="display: flex; justify-content: space-between; align-items: center;">
            <h2 id="ledger-heading" style="margin: 0; font-size: 18px; font-weight: 800; color: #0F172A;">
              Verified Brand Policy Ledger
            </h2>
            <span id="filtered-count-badge" style="font-size: 11px; font-weight: 700; color: #64748B; background: #F1F5F9; padding: 2px 8px; border-radius: 999px;">
              {totalBrands} Brands
            </span>
          </div>

          <div class="search-input-wrap">
            <span class="search-icon-inline">🔍</span>
            <input
              type="text"
              id="ledger-search-input"
              class="search-input"
              placeholder="Filter by brand name, category, or legal notes..."
            />
          </div>

          <div class="filter-chips-row" role="tablist" aria-label="Filter policies by type">
            <button type="button" class="filter-chip active" data-filter="all">All ({totalBrands})</button>
            <button type="button" class="filter-chip" data-filter="subscription">🔄 Subs ({totalSubs})</button>
            <button type="button" class="filter-chip" data-filter="hardware">🛡️ Warranties ({totalWarranties})</button>
            <button type="button" class="filter-chip" data-filter="fresh">✓ Fresh ({freshCount})</button>
          </div>
        </div>

        <div class="policy-list" id="emdash-policy-list">
          {enrichedBrands.map((brand) => (
            <div
              class="policy-row"
              data-slug={brand.brandSlug}
              data-category={brand.category}
              data-name={brand.brandName.toLowerCase()}
              data-notes={brand.legalNotes.toLowerCase()}
              data-fresh={brand.freshnessStatus}
            >
              <div class="row-header">
                <div class="brand-title-line">
                  <span class="brand-name">{brand.brandName}</span>
                  <span class={`cat-badge ${brand.category === 'subscription' ? 'sub' : ''}`}>
                    {brand.category === 'subscription' ? 'Sub' : 'Warranty'}
                  </span>
                </div>
                <div class="badge-cluster-right">
                  <span class={`status-badge ${brand.freshnessStatus === 'verified_fresh' ? 'status-fresh' : 'status-stale'}`} id={`badge-fresh-${brand.brandSlug}`}>
                    {brand.freshnessStatus === 'verified_fresh' ? `✓ Fresh (${brand.daysSinceVerified}d)` : 'Review Due'}
                  </span>
                  {brand.category === 'subscription' && (
                    <span class={`bgb-btn-pill ${brand.cancellationButtonCompliant ? '' : 'missing'}`} id={`badge-312k-${brand.brandSlug}`}>
                      {brand.cancellationButtonCompliant ? '§ 312k Button ✓' : 'Button Missing ⚠'}
                    </span>
                  )}
                </div>
              </div>

              <div class="row-middle">
                <span class="hash-pill" title="Cryptographic SHA-256 AGB Verification Fingerprint" id={`hash-${brand.brandSlug}`}>
                  SHA: {brand.agbSha256.slice(0, 14)}…
                </span>
                <a
                  href={`/wiki/${brand.brandSlug}`}
                  class="wiki-jump-link"
                  onclick="event.stopPropagation();"
                  target="_blank"
                >
                  Wiki Details ↗
                </a>
              </div>

              <p class="policy-notes-preview" id={`notes-${brand.brandSlug}`}>
                {brand.legalNotes}
              </p>
            </div>
          ))}
        </div>
      </section>

      <!-- Right Column: Live Policy Audit & Re-Hash Editor -->
      <aside class="editor-card" aria-labelledby="editor-heading">
        <h2 id="editor-heading" style="margin-top: 0; font-size: 18px; font-weight: 800; color: #0F172A;">
          Live Policy Audit &amp; Re-Hash
        </h2>
        <p style="font-size: 13px; color: #475569; margin-bottom: 16px; line-height: 1.4;">
          Select a brand to inspect. Committing updates instantly re-hashes statutory terms with SHA-256 and deploys to the Cloudflare Edge API.
        </p>

        <form id="emdash-audit-form">
          <div class="form-field">
            <label for="audit-slug">Target Brand</label>
            <select id="audit-slug" name="brandSlug">
              {enrichedBrands.map((b) => (
                <option value={b.brandSlug} data-category={b.category} data-compliant={String(b.cancellationButtonCompliant)} data-url={b.cancellationUrl || ''}>
                  {b.brandName} ({b.category})
                </option>
              ))}
            </select>
          </div>

          <div class="form-field">
            <label for="audit-state">Publication State</label>
            <select id="audit-state" name="publicationState">
              <option value="published">Published (Live &amp; Verified)</option>
              <option value="in_review">In Legal Review</option>
              <option value="draft">Draft (Internal Only)</option>
            </select>
          </div>

          <div class="form-field" id="wrap-cancel-url">
            <label for="audit-cancel-url">Direct Cancellation URL (§ 312k BGB)</label>
            <input
              type="url"
              id="audit-cancel-url"
              name="cancellationUrl"
              placeholder="https://provider.com/cancel"
            />
          </div>

          <div class="form-field" id="wrap-cancel-btn">
            <label class="checkbox-field">
              <input type="checkbox" id="audit-compliant" name="cancellationButtonCompliant" checked />
              <span style="font-size: 12px; font-weight: 600; color: #0F172A;">
                § 312k 2-Step Online Cancellation Button Present
              </span>
            </label>
          </div>

          <div class="form-field">
            <label for="audit-notes">Statutory Legal Notes &amp; AGB Review</label>
            <textarea
              id="audit-notes"
              name="legalNotes"
              rows="4"
              placeholder="Enter verified BGB § 309 Nr. 9, § 312k or § 477 audit notes..."
            ></textarea>
          </div>

          <button type="submit" class="commit-btn" id="commit-submit-btn">
            <span>Commit &amp; Re-Compute AGB SHA-256 ⚡</span>
          </button>

          <div id="emdash-status-alert" class="status-alert-box" role="alert"></div>
        </form>
      </aside>
    </div>
  </main>

  <script is:inline>
    // Client-side EmDash Interactive Controller
    let currentFilter = 'all';
    let searchQuery = '';

    const brandDataMap = new Map();
    document.querySelectorAll('.policy-row').forEach((row) => {
      const slug = row.dataset.slug;
      const notesEl = document.getElementById(`notes-${slug}`);
      const selectOpt = document.querySelector(`#audit-slug option[value="${slug}"]`);
      if (slug) {
        brandDataMap.set(slug, {
          slug,
          category: row.dataset.category,
          name: row.querySelector('.brand-name')?.textContent || slug,
          notes: notesEl?.textContent?.trim() || '',
          url: selectOpt?.dataset.url || '',
          compliant: selectOpt?.dataset.compliant === 'true',
        });
      }
    });

    function selectBrand(slug) {
      document.querySelectorAll('.policy-row').forEach((r) => r.classList.remove('selected'));
      const targetRow = document.querySelector(`.policy-row[data-slug="${slug}"]`);
      if (targetRow) {
        targetRow.classList.add('selected');
      }

      const slugSelect = document.getElementById('audit-slug');
      if (slugSelect) slugSelect.value = slug;

      const brand = brandDataMap.get(slug);
      if (brand) {
        const notesEl = document.getElementById('audit-notes');
        const urlEl = document.getElementById('audit-cancel-url');
        const compEl = document.getElementById('audit-compliant');
        if (notesEl) notesEl.value = brand.notes;
        if (urlEl) urlEl.value = brand.url;
        if (compEl) compEl.checked = brand.compliant;
      }
    }

    // Attach click listener to each row
    document.querySelectorAll('.policy-row').forEach((row) => {
      row.addEventListener('click', () => {
        const slug = row.dataset.slug;
        if (slug) selectBrand(slug);
      });
    });

    // Brand select change handler
    document.getElementById('audit-slug')?.addEventListener('change', (e) => {
      selectBrand(e.target.value);
    });

    // Select the first brand by default
    const firstRow = document.querySelector('.policy-row');
    if (firstRow && firstRow.dataset.slug) {
      selectBrand(firstRow.dataset.slug);
    }

    // Filter and search logic
    function applyFilters() {
      let visibleCount = 0;
      document.querySelectorAll('.policy-row').forEach((row) => {
        const category = row.dataset.category;
        const fresh = row.dataset.fresh;
        const name = row.dataset.name || '';
        const notes = row.dataset.notes || '';

        const matchesSearch = !searchQuery || name.includes(searchQuery) || notes.includes(searchQuery);
        let matchesFilter = true;
        if (currentFilter === 'subscription') matchesFilter = category === 'subscription';
        else if (currentFilter === 'hardware') matchesFilter = category === 'hardware';
        else if (currentFilter === 'fresh') matchesFilter = fresh === 'verified_fresh';

        if (matchesSearch && matchesFilter) {
          row.style.display = 'flex';
          visibleCount++;
        } else {
          row.style.display = 'none';
        }
      });

      const countBadge = document.getElementById('filtered-count-badge');
      if (countBadge) countBadge.textContent = `${visibleCount} Brands`;
    }

    document.getElementById('ledger-search-input')?.addEventListener('input', (e) => {
      searchQuery = e.target.value.toLowerCase().trim();
      applyFilters();
    });

    document.querySelectorAll('.filter-chip').forEach((chip) => {
      chip.addEventListener('click', () => {
        document.querySelectorAll('.filter-chip').forEach((c) => c.classList.remove('active'));
        chip.classList.add('active');
        currentFilter = chip.dataset.filter || 'all';
        applyFilters();
      });
    });

    // Live Audit Form Submission
    document.getElementById('emdash-audit-form')?.addEventListener('submit', async (e) => {
      e.preventDefault();
      const slugEl = document.getElementById('audit-slug');
      const stateEl = document.getElementById('audit-state');
      const urlEl = document.getElementById('audit-cancel-url');
      const compEl = document.getElementById('audit-compliant');
      const notesEl = document.getElementById('audit-notes');
      const alertBox = document.getElementById('emdash-status-alert');
      const submitBtn = document.getElementById('commit-submit-btn');

      if (!slugEl || !alertBox) return;

      const slug = slugEl.value;
      alertBox.className = 'status-alert-box';
      alertBox.style.display = 'block';
      alertBox.textContent = `Computing SHA-256 & committing update for '${slug}'...`;
      if (submitBtn) submitBtn.disabled = true;

      try {
        const res = await fetch('/api/emdash/policies', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({
            brandSlug: slug,
            publicationState: stateEl ? stateEl.value : 'published',
            legalNotes: notesEl ? notesEl.value : undefined,
            cancellationUrl: urlEl ? urlEl.value : undefined,
            cancellationButtonCompliant: compEl ? compEl.checked : undefined,
          }),
        });

        const data = await res.json();
        if (submitBtn) submitBtn.disabled = false;

        if (res.ok && data.ok && data.item) {
          alertBox.className = 'status-alert-box success';
          alertBox.textContent = `✓ Committed! AGB SHA-256: ${data.item.agbSha256.slice(0, 16)}… (${data.message})`;

          // Update in-memory brand map
          const b = brandDataMap.get(slug);
          if (b) {
            b.notes = data.item.legalNotes;
            b.url = data.item.cancellationUrl || '';
            b.compliant = Boolean(data.item.cancellationButtonCompliant);
          }

          // Update DOM row in real-time
          const hashEl = document.getElementById(`hash-${slug}`);
          if (hashEl) hashEl.textContent = `SHA: ${data.item.agbSha256.slice(0, 14)}…`;

          const notesPreviewEl = document.getElementById(`notes-${slug}`);
          if (notesPreviewEl) notesPreviewEl.textContent = data.item.legalNotes;

          const freshBadge = document.getElementById(`badge-fresh-${slug}`);
          if (freshBadge) {
            freshBadge.className = 'status-badge status-fresh';
            freshBadge.textContent = '✓ Fresh (0d)';
          }

          const bgbBadge = document.getElementById(`badge-312k-${slug}`);
          if (bgbBadge) {
            bgbBadge.className = `bgb-btn-pill ${data.item.cancellationButtonCompliant ? '' : 'missing'}`;
            bgbBadge.textContent = data.item.cancellationButtonCompliant ? '§ 312k Button ✓' : 'Button Missing ⚠';
          }
        } else {
          alertBox.className = 'status-alert-box error';
          alertBox.textContent = data.error || 'Failed to update policy record.';
        }
      } catch (err) {
        if (submitBtn) submitBtn.disabled = false;
        alertBox.className = 'status-alert-box error';
        alertBox.textContent = 'Network error communicating with EmDash API.';
      }
    });
  </script>
</body>
</html>
