---
import { policySeedData } from '@cmlab/core';
import '../../styles/tokens.css';
import '../../styles/main.css';

export const prerender = true;
---

<!DOCTYPE html>
<html lang="de" data-theme="light">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
  <title>EmDash Policy &amp; Telemetry Desk · Rights &amp; Renewals</title>
  <meta name="description" content="EmDash CMS Editorial & Policy Telemetry Desk for Rights & Renewals Top 20 Student Brand Policies." />
  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  <link rel="icon" type="image/png" sizes="64x64" href="/favicon.png" />
  <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
  <link rel="stylesheet" href="/styles/tokens.css" />
  <link rel="stylesheet" href="/styles/main.css" />
  <style>
    .emdash-shell {
      max-width: 1200px;
      margin: 0 auto;
      padding: 32px 16px 80px;
    }
    .emdash-header {
      display: flex;
      justify-content: space-between;
      align-items: flex-start;
      flex-wrap: wrap;
      gap: 16px;
      margin-bottom: 28px;
      padding-bottom: 20px;
      border-bottom: 1px solid var(--color-border-subtle, #E2E8F0);
    }
    .emdash-metrics {
      display: grid;
      grid-template-columns: 1fr;
      gap: var(--space-4);
      margin-bottom: var(--space-8);
    }
    @media (min-width: 900px) {
      .emdash-metrics {
        grid-template-columns: 2fr 1fr 1fr 1fr;
      }
    }
    .metric-card {
      background: var(--color-surface-card);
      border: 1px solid var(--color-border-subtle);
      border-radius: var(--radius-xl);
      padding: var(--space-5);
      transition: transform 180ms cubic-bezier(0.16, 1, 0.3, 1), border-color 180ms ease;
    }
    .metric-card:first-child {
      border-left: 3px solid var(--color-brand-primary);
      background: var(--color-surface-subtle);
    }
    .metric-card:hover {
      transform: translateY(-2px);
      border-color: var(--color-brand-primary);
    }
    .metric-label {
      font-size: 12px;
      font-weight: 700;
      text-transform: uppercase;
      letter-spacing: 0.05em;
      color: var(--color-text-secondary);
    }
    .metric-value {
      font-size: 28px;
      font-weight: 800;
      letter-spacing: -0.015em;
      color: var(--color-brand-primary);
      margin-top: 6px;
    }
    .emdash-grid {
      display: grid;
      grid-template-columns: 7fr 5fr;
      gap: var(--space-6);
      align-items: start;
    }
    @media (max-width: 960px) {
      .emdash-grid {
        grid-template-columns: 1fr;
      }
    }
    .policy-table-card, .editor-card {
      background: var(--color-surface-card);
      border: 1px solid var(--color-border-subtle);
      border-radius: var(--radius-xl);
      padding: var(--space-6);
    }
    .policy-row {
      display: flex;
      justify-content: space-between;
      align-items: center;
      gap: var(--space-3);
      padding: var(--space-3) 0;
      border-bottom: 1px solid var(--color-border-subtle);
    }
    .policy-row:last-child {
      border-bottom: none;
    }
    .hash-pill {
      font-family: var(--font-mono);
      font-size: 11px;
      background: var(--color-surface-subtle);
      color: var(--color-brand-primary);
      border: 1px solid var(--color-border-subtle);
      padding: 3px 8px;
      border-radius: var(--radius-sm);
    }
    .status-fresh {
      background: var(--color-status-protected-bg);
      color: var(--color-status-protected-text);
      border: 1px solid var(--color-status-protected-border);
      font-size: 12px;
      font-weight: 700;
      padding: 3px 10px;
      border-radius: var(--radius-full);
    }
    .form-field {
      margin-bottom: var(--space-4);
    }
    .form-field label {
      display: block;
      font-size: 13px;
      font-weight: 600;
      margin-bottom: 6px;
      color: var(--color-text-primary);
    }
    .form-field select, .form-field input, .form-field textarea {
      width: 100%;
      padding: 10px 12px;
      border: 1px solid var(--color-border-default);
      border-radius: var(--radius-md);
      font-size: 14px;
      background: var(--color-surface-subtle);
      color: var(--color-text-primary);
    }
  </style>
</head>
<body>
  <header role="banner" class="showcase-header">
    <div class="layout-container header-inner">
      <a href="/" class="brand-link" style="display: inline-flex; align-items: center; gap: 10px;">
        <img src="/favicon.svg" alt="Rights & Renewals Icon" width="32" height="32" style="border-radius: 8px;" />
        <span class="brand-name">Rights &amp; Renewals</span>
      </a>
      <nav class="nav-links" aria-label="EmDash Navigation">
        <a href="/" class="nav-item">Showcase</a>
        <a href="/wiki" class="nav-item">Brand Policy Wiki</a>
        <a href="/emdash" class="nav-item" aria-current="page">EmDash CMS Desk</a>
      </nav>
      <div class="nav-actions">
        <a href="https://rightsandrenewals-app.pages.dev/" data-legacy-url="https://app.cm-lab.pages.dev/" class="btn-compact btn-primary" target="_blank" rel="noopener noreferrer">
          📱 Zur Wallet-App ↗
        </a>
      </div>
    </div>
  </header>

  <main class="emdash-shell">
    <div class="emdash-header">
      <div>
        <span class="hero-pill-badge">⚡ EmDash CMS · DOC-DEV-05 &amp; DOC-QA-02</span>
        <h1 style="font-size: 32px; font-weight: 800; margin: 10px 0 6px;">EmDash Policy &amp; AGB Telemetry Desk</h1>
        <p style="color: var(--color-ink-secondary, #475569); margin: 0;">
          Live Cloudflare Edge editorial desk managing the Top 20 student brand policies, SHA-256 AGB revision hashes, and 90-day freshness SLAs.
        </p>
      </div>
      <a href="/api/emdash/policies" target="_blank" class="btn-compact btn-outline">
        { } Raw JSON API (/api/emdash/policies) ↗
      </a>
    </div>

    <section class="emdash-metrics" aria-label="EmDash Telemetry Metrics">
      <div class="metric-card">
        <div class="metric-label">Canonical Brands</div>
        <div class="metric-value" id="metric-total">{policySeedData.length}</div>
      </div>
      <div class="metric-card">
        <div class="metric-label">90-Day Freshness SLA</div>
        <div class="metric-value" id="metric-fresh">20 / 20 Fresh</div>
      </div>
      <div class="metric-card">
        <div class="metric-label">§ 312k BGB Button Compliance</div>
        <div class="metric-value" id="metric-312k">Verified</div>
      </div>
      <div class="metric-card">
        <div class="metric-label">Zero-PII Edge Firewall</div>
        <div class="metric-value" style="color: #059669;">ACTIVE (GDPR Art. 25)</div>
      </div>
    </section>

    <div class="emdash-grid">
      <section class="policy-table-card" aria-labelledby="ledger-heading">
        <h2 id="ledger-heading" style="margin-top: 0; font-size: 20px;">Verified Brand Policy Ledger (AGB SHA-256)</h2>
        <div id="emdash-policy-list">
          {policySeedData.map((brand) => (
            <div class="policy-row" data-slug={brand.brandSlug}>
              <div>
                <strong>{brand.brandName}</strong>
                <span style="font-size: 12px; color: #64748B; margin-left: 6px;">({brand.category})</span>
                <div style="font-size: 13px; color: #475569; margin-top: 4px;" class="policy-notes">{brand.legalNotes}</div>
              </div>
              <div style="text-align: right; flex-shrink: 0;">
                <span class="status-fresh">Verified {brand.verifiedDate}</span>
                <div style="margin-top: 6px;">
                  <a href={`/wiki/${brand.brandSlug}`} style="font-size: 12px; font-weight: 600; color: #0B3B4C;">View Wiki ↗</a>
                </div>
              </div>
            </div>
          ))}
        </div>
      </section>

      <aside class="editor-card" aria-labelledby="editor-heading">
        <h2 id="editor-heading" style="margin-top: 0; font-size: 18px;">Live Policy Audit &amp; Re-Hash</h2>
        <p style="font-size: 13px; color: #475569; margin-bottom: 16px;">
          Publish an instant AGB verification update to the Cloudflare Edge `/api/emdash/policies` endpoint.
        </p>
        <form id="emdash-audit-form">
          <div class="form-field">
            <label for="audit-slug">Brand</label>
            <select id="audit-slug" name="brandSlug">
              {policySeedData.map((b) => (
                <option value={b.brandSlug}>{b.brandName} ({b.brandSlug})</option>
              ))}
            </select>
          </div>
          <div class="form-field">
            <label for="audit-state">Publication State</label>
            <select id="audit-state" name="publicationState">
              <option value="published">Published (Verified)</option>
              <option value="in_review">In Legal Review</option>
              <option value="draft">Draft</option>
            </select>
          </div>
          <div class="form-field">
            <label for="audit-notes">Updated Statutory / AGB Notes</label>
            <textarea id="audit-notes" rows="3" placeholder="Enter verified BGB § 309 Nr. 9 / § 312k or § 477 audit note..."></textarea>
          </div>
          <button type="submit" class="btn-compact btn-primary" style="width: 100%; justify-content: center;">
            Commit &amp; Re-Compute AGB SHA-256
          </button>
          <p id="emdash-status-msg" style="font-size: 13px; margin-top: 12px; font-weight: 600;"></p>
        </form>
      </aside>
    </div>
  </main>

  <script is:inline>
    async function refreshEmDashLedger() {
      try {
        const res = await fetch('/api/emdash/policies');
        if (!res.ok) return;
        const data = await res.json();
        const metric312k = document.getElementById('metric-312k');
        if (metric312k && data.telemetrySummary) {
          metric312k.textContent = data.telemetrySummary.bgb312kComplianceRatio + ' Compliant';
        }
      } catch (e) {}
    }

    document.getElementById('emdash-audit-form')?.addEventListener('submit', async (e) => {
      e.preventDefault();
      const slugEl = document.getElementById('audit-slug');
      const stateEl = document.getElementById('audit-state');
      const notesEl = document.getElementById('audit-notes');
      const msgEl = document.getElementById('emdash-status-msg');
      if (!slugEl || !msgEl) return;

      msgEl.textContent = 'Updating EmDash policy record...';
      try {
        const res = await fetch('/api/emdash/policies', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({
            brandSlug: slugEl.value,
            publicationState: stateEl ? stateEl.value : 'published',
            legalNotes: notesEl && notesEl.value ? notesEl.value : undefined,
          }),
        });
        const data = await res.json();
        if (res.ok && data.ok) {
          msgEl.style.color = '#059669';
          msgEl.textContent = `${data.message} [SHA-256: ${data.item.agbSha256.slice(0, 12)}…]`;
          await refreshEmDashLedger();
        } else {
          msgEl.style.color = '#DC2626';
          msgEl.textContent = data.error || 'Update failed';
        }
      } catch (err) {
        msgEl.style.color = '#DC2626';
        msgEl.textContent = 'Network error communicating with EmDash API.';
      }
    });

    refreshEmDashLedger();
  </script>
</body>
</html>
