---
interface Props {
  humanHref: string;
  machineHref: string;
}

const { humanHref, machineHref } = Astro.props;
---

<nav class="audience-chips" aria-label="Content format">
  <a href={humanHref} aria-current="page">Human</a>
  <a href={machineHref} type="text/markdown">Machine</a>
</nav>

<style>
  .audience-chips {
    display: flex;
    justify-content: center;
    gap: 6px;
    padding: 14px 12px;
  }

  a {
    display: grid;
    place-items: center;
    min-height: 48px;
    min-width: 86px;
    padding: 6px 15px;
    border: 1px solid var(--color-border-subtle, #cbd5d1);
    border-radius: 999px;
    background: var(--color-surface-card, #fff);
    color: var(--color-text-primary, #182f2b);
    font-size: 14px;
    font-weight: 700;
    text-decoration: none;
  }

  a[aria-current="page"] {
    background: #2f524c;
    color: #fff;
  }

  a:focus-visible {
    outline: 3px solid var(--color-border-focus, #2563eb);
    outline-offset: 3px;
  }
</style>
