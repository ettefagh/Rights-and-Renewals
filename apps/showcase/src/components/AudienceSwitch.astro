---
interface Props {
  humanHref: string;
  machineHref: string;
  active?: 'human' | 'machine';
}

const { humanHref, machineHref, active = 'human' } = Astro.props;
---

<nav class="audience-chips" aria-label="Content format">
  <a href={humanHref} aria-current={active === 'human' ? 'page' : undefined}>Human</a>
  <a href={machineHref} aria-current={active === 'machine' ? 'page' : undefined}>Machine</a>
</nav>

<script is:inline>
  (() => {
    const switcher = document.querySelector('.audience-chips');
    const update = () => switcher.toggleAttribute('data-compact', window.scrollY > 32);

    update();
    window.addEventListener('pageshow', update);
    window.addEventListener('scroll', update, { passive: true });
  })();
</script>

<style>
  :global(body:has(.audience-chips)) {
    padding-bottom: calc(78px + env(safe-area-inset-bottom, 0px));
  }

  .audience-chips {
    position: fixed;
    z-index: var(--z-index-navbar, 200);
    inset-inline-start: 50%;
    bottom: calc(12px + env(safe-area-inset-bottom, 0px));
    transform: translateX(-50%);
    display: flex;
    gap: 3px;
    padding: 4px;
    border: 1px solid var(--color-border-subtle, #cbd5d1);
    border-radius: 999px;
    background: color-mix(in srgb, var(--color-surface-card, #fff) 92%, transparent);
    box-shadow: var(--elevation-md, 0 4px 20px rgb(24 47 43 / 16%));
    backdrop-filter: blur(12px);
  }

  a {
    display: grid;
    place-items: center;
    min-height: 48px;
    min-width: 72px;
    padding-inline: 15px;
    border-radius: 999px;
    color: var(--color-text-primary, #182f2b);
    font: 700 14px/1 system-ui, sans-serif;
    text-decoration: none;
    transition: padding 180ms ease, min-height 180ms ease, font-size 180ms ease;
  }

  .audience-chips[data-compact] a {
    padding-inline: 10px;
    font-size: 12px;
  }

  a[aria-current="page"] {
    background: var(--color-brand-primary, #2f524c);
    color: var(--color-text-inverse, #fff);
  }

  a:focus-visible {
    outline: 2px solid var(--color-border-focus, #2563eb);
    outline-offset: 1px;
  }

  @media (prefers-reduced-motion: reduce) {
    a { transition: none; }
  }
</style>
