---
import '../../../styles/editorial-sections.css';
import type { WebsiteBlock, WebsiteBlockPlacement } from '../../lib/website-cms.js';

interface Props { sections: WebsiteBlock[]; title?: string; preview?: boolean; placement?: WebsiteBlockPlacement; headingLevel?: 'h1' | 'h2'; headingId?: string }
const { sections, title, preview = false, placement = 'content', headingLevel = 'h2', headingId } = Astro.props;
const placedSections = sections.filter((section) => section.placement === placement);
const primaryHeadingIndex = placedSections.findIndex((section) => typeof section.heading === 'string');
const safeId = (value: unknown, fallback: string) => typeof value === 'string' && /^[A-Za-z][A-Za-z0-9_-]{0,119}$/.test(value) ? value : fallback;
---

{preview && <p class="editorial-preview-banner" role="status">Draft preview · this page is not public content.</p>}
{title && <h1 class="editorial-page-title">{title}</h1>}
<div class:list={['editorial-sections', placement === 'content' ? '' : 'editorial-sections--slot']}>
  {placedSections.map((section, index) => (
    <section class={`editorial-section editorial-section--${section._type}`} id={safeId(section._key, `section-${index + 1}`)}>
      {section.heading && (headingLevel === 'h1' && index === primaryHeadingIndex ? <h1 id={headingId}>{section.heading as string}</h1> : <h2>{section.heading as string}</h2>)}
      {section.body && <p>{section.body as string}</p>}
      {section._type === 'feature_list' && Array.isArray(section.items) && (
        <ul>{section.items.map((item) => <li><strong>{item.title}</strong><span>{item.body}</span></li>)}</ul>
      )}
      {section._type === 'faq' && Array.isArray(section.questions) && (
        <dl>{section.questions.map((item) => <><dt>{item.question}</dt><dd>{item.answer}</dd></>)}</dl>
      )}
      {typeof section.cta_label === 'string' && typeof section.cta_url === 'string' && typeof section.cta_id === 'string' && (
        <a class="editorial-cta" data-cta-id={section.cta_id} href={section.cta_url}>{section.cta_label}</a>
      )}
    </section>
  ))}
</div>

<style>
  .editorial-sections--slot { width: auto; margin: 0; gap: 0; padding: 0; }
  .editorial-sections--slot .editorial-section { padding: 0; border: 0; border-radius: 0; background: transparent; }
  .editorial-sections--slot .editorial-section h1 { margin: 0 0 .75rem; font-size: clamp(2.2rem, 5vw, 4rem); line-height: 1.04; }
  .editorial-sections--slot .editorial-section h2 { margin: 0 0 .75rem; }
</style>
