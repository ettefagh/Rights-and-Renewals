{
  "$schema": "https://schemas.agentskills.io/skill/0.2.0/schema.json",
  "name": "policy-lookup",
  "version": "1.0.0",
  "type": "skill-json",
  "description": "Look up German statutory warranty rules, 12-month burden of proof transition cliff, and subscription cancellation terms for consumer brands.",
  "invocation": {
    "type": "mcp",
    "endpoint": "https://rightsandrenewals.pages.dev/api/mcp",
    "tool": "policy_lookup",
    "method": "POST"
  },
  "parameters": {
    "type": "object",
    "properties": {
      "service_slug": {
        "type": "string",
        "description": "Brand or service slug (e.g. 'spotify', 'apple', 'mediamarkt')"
      },
      "brand_slug": {
        "type": "string",
        "description": "Alternative alias for service_slug"
      },
      "category": {
        "type": "string",
        "enum": [
          "hardware",
          "subscription"
        ],
        "description": "Category filter for brand policy lookups"
      }
    },
    "required": [
      "service_slug"
    ]
  },
  "examples": [
    {
      "intent": "Check warranty terms for MediaMarkt purchase",
      "arguments": {
        "service_slug": "mediamarkt",
        "category": "hardware"
      }
    },
    {
      "intent": "Look up Spotify cancellation policy in Germany",
      "arguments": {
        "service_slug": "spotify",
        "category": "subscription"
      }
    }
  ]
}
