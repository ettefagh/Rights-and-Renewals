---
import { getShowcaseUrl } from '../lib/showcase-url';

export const prerender = true;

const adminUrl = getShowcaseUrl('/_emdash/admin');
---
<!DOCTYPE html>
<html lang="de">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>EmDash Policy Desk · Rights &amp; Renewals</title>
  {adminUrl && <meta http-equiv="refresh" content={`0; url=${adminUrl}`} />}
  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  <style>
    body {
      font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
      background: #F4F7F6;
      color: #0F172A;
      display: flex;
      align-items: center;
      justify-content: center;
      min-height: 100vh;
      margin: 0;
      padding: 20px;
      text-align: center;
      box-sizing: border-box;
    }
    .redirect-card {
      background: #FFFFFF;
      border: 1px solid #E2E8F0;
      border-radius: 20px;
      padding: 36px 28px;
      max-width: 440px;
      box-shadow: 0 10px 25px -5px rgba(15, 23, 42, 0.08);
      display: flex;
      flex-direction: column;
      align-items: center;
      gap: 12px;
    }
    .logo {
      width: 44px;
      height: 44px;
      border-radius: 10px;
    }
    .title {
      font-size: 20px;
      font-weight: 800;
      margin: 0;
      color: #0F172A;
    }
    .desc {
      font-size: 14px;
      color: #475569;
      margin: 0;
      line-height: 1.4;
    }
    .btn {
      display: inline-flex;
      align-items: center;
      gap: 6px;
      margin-top: 8px;
      padding: 10px 20px;
      border-radius: 10px;
      background: #2F524C;
      color: #FFFFFF;
      font-size: 14px;
      font-weight: 700;
      text-decoration: none;
      transition: background 150ms ease;
    }
    .btn:hover {
      background: #233F3A;
    }
  </style>
</head>
<body>
  <div class="redirect-card">
    <img src="/favicon.svg" alt="Rights & Renewals" class="logo" />
    {adminUrl && <h1 class="title">Opening EmDash Policy Desk...</h1>}
    {adminUrl && <p class="desc">Connecting to the EmDash editorial dashboard.</p>}
    {adminUrl && <a href={adminUrl} class="btn"><span>Open EmDash Desk Directly ↗</span></a>}
    {!adminUrl && <h1 class="title">EmDash Desk Unavailable</h1>}
    {!adminUrl && <p class="desc">The editorial dashboard link is not configured for this wallet.</p>}
  </div>
</body>
</html>
