{
  "name": "@cmlab/app",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "CM-LAB Modern Application Interface (app.[Project].page.dev) with Unified Omnibar and Dashboard",
  "scripts": {
    "serve": "python -m http.server 3001 --directory .",
    "serve:node": "node -e \"const http=require('http'),fs=require('fs'),p=require('path');http.createServer((q,s)=>{let f=p.join('.',q.url==='/'?'index.html':q.url.split('?')[0]);fs.readFile(f,(e,d)=>{if(e){s.writeHead(404);s.end('Not Found')}else{s.writeHead(200,{'Content-Type':f.endsWith('.css')?'text/css':f.endsWith('.js')?'application/javascript':f.endsWith('.json')?'application/json':f.endsWith('.svg')?'image/svg+xml':'text/html'});s.end(d)}})}).listen(3001,()=>console.log('Serving on http://localhost:3001'))\"",
    "test:e2e": "python ../../tests/e2e/runner.py"
  },
  "dependencies": {
    "@harshmandan/svaul": "^2.0.0",
    "@iconify-json/simple-icons": "^1.2.101",
    "lucide-svelte": "^1.0.1",
    "unplugin-icons": "^24.0.0"
  }
}
